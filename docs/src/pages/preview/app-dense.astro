---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewToolbar from '../../components/PreviewToolbar.astro';

// --- Mock data: High-density quantitative trading & execution console ------

interface Metric {
  label: string;
  value: string;
  delta: string;
  direction: 'up' | 'down' | 'flat';
  tone: 'accent' | 'success' | 'danger' | 'warning';
}

const metrics: Metric[] = [
  { label: 'Net Delta', value: '+$4.82M', delta: '+8.4%', direction: 'up', tone: 'accent' },
  { label: 'Gross Exp', value: '$42.8M', delta: '-1.2%', direction: 'down', tone: 'accent' },
  { label: 'Fill Rate', value: '99.84%', delta: '+0.02%', direction: 'up', tone: 'success' },
  { label: 'Latency p99', value: '14.2µs', delta: '-3.1µs', direction: 'down', tone: 'success' },
  { label: 'VWAP Slip', value: '-0.42 bps', delta: '-0.15', direction: 'down', tone: 'success' },
  { label: 'Sharpe (1D)', value: '3.42', delta: '+0.12', direction: 'up', tone: 'accent' },
  { label: 'Open Orders', value: '1,284', delta: 'stable', direction: 'flat', tone: 'warning' },
  { label: 'Reject Rate', value: '0.02%', delta: '-0.01%', direction: 'down', tone: 'success' },
];

type Side = 'BUY' | 'SELL';
type OrderStatus = 'active' | 'ack' | 'resolved';

interface OrderRow {
  ts: string;
  symbol: string;
  side: Side;
  type: string;
  price: string;
  qty: string;
  filled: string;
  venue: string;
  status: OrderStatus;
  statusText: string;
}

const orders: OrderRow[] = [
  { ts: '14:32:07.412', symbol: '$NVDA', side: 'BUY', type: 'LIMIT', price: '128.45', qty: '5,000', filled: '100%', venue: 'NASDAQ', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:31:54.108', symbol: '$AAPL', side: 'SELL', type: 'IOC', price: '224.18', qty: '12,500', filled: '65.6%', venue: 'ARCA', status: 'ack', statusText: 'PARTIAL' },
  { ts: '14:31:22.890', symbol: '$MSFT', side: 'BUY', type: 'LIMIT', price: '428.10', qty: '3,200', filled: '0%', venue: 'IEX', status: 'active', statusText: 'WORKING' },
  { ts: '14:30:48.331', symbol: 'BTC-PERP', side: 'BUY', type: 'ICEBERG', price: '68,420.50', qty: '40.0', filled: '100%', venue: 'DERIBIT', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:30:15.654', symbol: '$AMZN', side: 'SELL', type: 'LIMIT', price: '186.30', qty: '8,000', filled: '100%', venue: 'BATS', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:29:33.201', symbol: '$TSLA', side: 'SELL', type: 'FOK', price: '254.80', qty: '15,000', filled: '0%', venue: 'MEMX', status: 'active', statusText: 'WORKING' },
  { ts: '14:28:51.912', symbol: '$META', side: 'BUY', type: 'LIMIT', price: '584.25', qty: '2,500', filled: '80.0%', venue: 'NASDAQ', status: 'ack', statusText: 'PARTIAL' },
  { ts: '14:28:14.542', symbol: 'ETH-PERP', side: 'BUY', type: 'LIMIT', price: '2,640.80', qty: '350.0', filled: '100%', venue: 'DERIBIT', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:27:39.117', symbol: '$GOOGL', side: 'SELL', type: 'LIMIT', price: '168.90', qty: '6,400', filled: '100%', venue: 'ARCA', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:26:58.784', symbol: '$AVGO', side: 'BUY', type: 'POST-ONLY', price: '174.50', qty: '1,800', filled: '0%', venue: 'IEX', status: 'active', statusText: 'WORKING' },
  { ts: '14:26:12.339', symbol: '$AMD', side: 'BUY', type: 'LIMIT', price: '152.40', qty: '7,500', filled: '100%', venue: 'NASDAQ', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:25:33.091', symbol: '$PLTR', side: 'SELL', type: 'IOC', price: '42.85', qty: '20,000', filled: '100%', venue: 'BATS', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:24:47.604', symbol: '$SMCI', side: 'SELL', type: 'LIMIT', price: '48.10', qty: '10,000', filled: '25.0%', venue: 'EDGX', status: 'ack', statusText: 'PARTIAL' },
  { ts: '14:24:01.218', symbol: '$COIN', side: 'BUY', type: 'LIMIT', price: '214.60', qty: '4,500', filled: '100%', venue: 'ARCA', status: 'resolved', statusText: 'FILLED' },
  { ts: '14:23:18.995', symbol: '$ARM', side: 'BUY', type: 'LIMIT', price: '146.20', qty: '3,800', filled: '0%', venue: 'IEX', status: 'active', statusText: 'WORKING' },
];

const navSections = [
  { label: 'Execution', items: ['Order Book', 'Active Orders', 'Exec Fills', 'Algo Strategies', 'Smart Router'] },
  { label: 'Risk & Margins', items: ['Position Matrix', 'VaR Monitor', 'Greeks & Skew', 'Liquidity Curves'] },
  { label: 'Infrastructure', items: ['Colo Gateways', 'FIX Sessions', 'Clock Sync (PTP)', 'Audit Ledger'] },
];
---

<BaseLayout title="High-Density Quantitative Execution Terminal · Porchlight" palette="zinc" theme="dark" density="dense">
  <PreviewToolbar palette="zinc" theme="dark" density="dense" title="Quantitative Trading & Execution Terminal" />

  <div data-pl-density="dense" class="dense-app">
    <header class="dense-topbar">
      <div class="dense-topbar__left">
        <button class="pl-c-button" data-variant="ghost" data-icon-only aria-label="Toggle sidebar" data-toggle="sidebar">
          <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18" stroke-linecap="round"/></svg>
        </button>
        <strong class="dense-brand">QUANTUM<span>//EXEC</span></strong>
        <span class="pl-c-badge" data-tone="success">● NASDAQ-L2 LIVE</span>
      </div>
      <div class="dense-search">
        <input class="pl-c-field__control pl-c-field__input" data-elastic="true" placeholder="Search orders, symbols, routing venues, CUSIP…" aria-label="Search" />
        <kbd class="pl-c-kbd dense-kbd">⌘K</kbd>
      </div>
      <div class="dense-topbar__right">
        <span class="pl-c-badge" data-tone="accent">14.2µs L2</span>
        <span class="pl-c-badge" data-tone="danger">0 halts</span>
        <button class="pl-c-button" data-variant="ghost" aria-label="Notifications">
          <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <div class="dense-body">
      <nav class="dense-sidebar">
        {navSections.map((section) => (
          <div class="dense-nav-group">
            <span class="dense-nav-label">{section.label}</span>
            {section.items.map((item) => (
              <a class="dense-nav-item" class:list={[{ 'is-active': item === 'Active Orders' }]} href="#">
                <span>{item}</span>
                {item === 'Active Orders' && <span class="pl-c-badge pl-c-badge--mini" data-tone="warning">15</span>}
                {item === 'Exec Fills' && <span class="pl-c-badge pl-c-badge--mini" data-tone="success">1.4k</span>}
                {item === 'Colo Gateways' && <span class="pl-c-badge pl-c-badge--mini" data-tone="accent">4/4</span>}
              </a>
            ))}
          </div>
        ))}
      </nav>

      <main class="dense-main">
        <!-- KPI strip (8 metrics) -->
        <div class="dense-kpis pl-l-grid" style="--pl-l-grid-min: 130px; gap: var(--pl-space-2);">
          {metrics.map((m) => (
            <article class="pl-c-kpi-card dense-kpi" data-tone={m.tone}>
              <header class="pl-c-kpi-card__header">
                <span class="pl-c-kpi-card__label dense-kpi__label">{m.label}</span>
              </header>
              <div class="pl-c-kpi-card__metric">
                <span class="pl-c-kpi-card__value dense-kpi__value">{m.value}</span>
              </div>
              <footer class="pl-c-kpi-card__footer">
                <span
                  class="pl-c-kpi-card__delta dense-kpi__delta"
                  data-tone={m.tone}
                  data-direction={m.direction}
                >
                  {m.delta}
                </span>
              </footer>
            </article>
          ))}
        </div>

        <!-- Hotkeys Quick Strip -->
        <div class="dense-hotkeys">
          <div class="dense-hotkeys__group">
            <span class="dense-hotkeys__label">Direct Access Keys:</span>
            <span class="dense-hotkeys__item"><kbd class="pl-c-kbd">F1</kbd> Buy Limit</span>
            <span class="dense-hotkeys__item"><kbd class="pl-c-kbd">F2</kbd> Sell Limit</span>
            <span class="dense-hotkeys__item"><kbd class="pl-c-kbd">F4</kbd> Flatten All</span>
            <span class="dense-hotkeys__item"><kbd class="pl-c-kbd">Space</kbd> Center Depth</span>
          </div>
          <div class="dense-hotkeys__status">
            <span class="dense-pulse"></span> Matching Core 0 (Secaucus NY4)
          </div>
        </div>

        <!-- Toolbar -->
        <div class="dense-toolbar">
          <div class="dense-toolbar__left">
            <button class="pl-c-button" data-variant="primary" data-size="sm">All Orders</button>
            <button class="pl-c-button" data-variant="ghost" data-size="sm">Limit</button>
            <button class="pl-c-button" data-variant="ghost" data-size="sm">Market / IOC</button>
            <button class="pl-c-button" data-variant="ghost" data-size="sm">Iceberg</button>
            <span class="dense-toolbar__count">15 orders · 1,482 fills/sec</span>
          </div>
          <div class="dense-toolbar__right">
            <button class="pl-c-button" data-variant="secondary">
              <svg width="0.875em" height="0.875em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M7 12h10M11 18h2" stroke-linecap="round"/></svg>
              Filter Desks
            </button>
            <button class="pl-c-button" data-variant="secondary">
              <svg width="0.875em" height="0.875em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Export FIX
            </button>
            <div class="pl-c-split" style="--pl-c-split-anchor: --dsb-1;">
              <button type="button" class="pl-c-button pl-c-split__primary" data-variant="primary">Route Batch (F9)</button>
              <button type="button" class="pl-c-button pl-c-split__toggle" data-variant="primary" popovertarget="dsb-1" aria-label="More actions">
                <svg class="pl-c-split__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <div popover class="pl-c-split__menu" id="dsb-1">
                <button class="pl-c-split__option">Sweep Dark Pools</button>
                <button class="pl-c-split__option">Rebalance Pegs</button>
                <hr class="pl-c-menu__divider" />
                <button class="pl-c-split__option" data-tone="danger">Cancel All Working (Esc)</button>
                <button class="pl-c-split__option" data-tone="danger">Emergency Kill Switch</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Orders Table -->
        <div class="pl-c-table-wrap dense-table" data-pl-density="dense" tabindex="0">
          <table class="pl-c-table">
            <thead>
              <tr>
                <th data-sort="desc">Timestamp</th>
                <th>Symbol</th>
                <th>Side</th>
                <th>Type</th>
                <th data-align="end">Price ($)</th>
                <th data-align="end">Size / Qty</th>
                <th data-align="end">Fill %</th>
                <th>Venue</th>
                <th data-align="end">Status</th>
              </tr>
            </thead>
            <tbody>
              {orders.map((o) => (
                <tr>
                  <td class="dense-mono">{o.ts}</td>
                  <td class="dense-mono font-semibold"><strong>{o.symbol}</strong></td>
                  <td>
                    <span class="pl-c-badge" data-tone={o.side === 'BUY' ? 'success' : 'danger'}>
                      {o.side}
                    </span>
                  </td>
                  <td class="dense-mono">{o.type}</td>
                  <td data-align="end" class="dense-mono">{o.price}</td>
                  <td data-align="end" class="dense-mono">{o.qty}</td>
                  <td data-align="end" class="dense-mono">{o.filled}</td>
                  <td class="dense-mono"><span class="pl-u-tabular-nums">{o.venue}</span></td>
                  <td data-align="end">
                    <span class:list={['dense-status', `dense-status--${o.status}`]}>{o.statusText}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="dense-pager">
          <span class="dense-toolbar__count">Showing 1–15 of 1,284 open orders</span>
          <nav class="pl-c-pagination">
            <button class="pl-c-button" data-variant="ghost" aria-label="Previous">‹</button>
            <button class="pl-c-button" data-variant="ghost" aria-pressed="true">1</button>
            <button class="pl-c-button" data-variant="ghost">2</button>
            <button class="pl-c-button" data-variant="ghost">3</button>
            <span class="dense-pager__ellipsis">…</span>
            <button class="pl-c-button" data-variant="ghost">86</button>
            <button class="pl-c-button" data-variant="ghost" aria-label="Next">›</button>
          </nav>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .dense-app {
    display: flex;
    flex-direction: column;
    min-block-size: calc(100dvh - 3.5rem);
    inline-size: calc(100% + (2 * var(--pl-space-8)));
    overflow: hidden;
    margin-inline: calc(-1 * var(--pl-space-8));
    margin-block-end: calc(-1 * var(--pl-space-8));
    background: var(--pl-color-bg);
    font-size: var(--pl-text-sm);
  }

  /* Topbar */
  .dense-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pl-space-3);
    padding: var(--pl-space-1) var(--pl-space-3);
    min-inline-size: 0;
    border-block-end: 1px solid var(--pl-color-border);
    background: color-mix(in oklab, var(--pl-color-surface), transparent 12%);
    backdrop-filter: blur(8px);
    flex-shrink: 0;
  }
  .dense-topbar__left,
  .dense-topbar__right {
    display: flex;
    align-items: center;
    gap: var(--pl-space-2);
    min-inline-size: 0;
  }
  .dense-brand {
    font-size: var(--pl-text-sm);
    letter-spacing: 0.05em;
    color: var(--pl-color-text);
  }
  .dense-brand span {
    color: var(--pl-color-accent);
  }
  .dense-search {
    position: relative;
    flex: 1;
    min-inline-size: 12rem;
    max-inline-size: 32rem;
  }
  .dense-search input {
    inline-size: 100%;
    min-block-size: 1.75rem;
    padding-inline: var(--pl-space-3);
    border: 1px solid var(--pl-color-border);
    border-radius: var(--pl-radius-sm);
    background: var(--pl-color-surface);
    color: var(--pl-color-text);
    font-size: var(--pl-text-sm);
    font-family: inherit;
  }
  .dense-search input:focus-visible {
    outline: var(--pl-focus-size) solid var(--pl-focus-color);
    outline-offset: var(--pl-focus-offset);
    border-color: var(--pl-color-accent);
  }
  .dense-kbd {
    position: absolute;
    inset-inline-end: var(--pl-space-2);
    inset-block: 0;
    margin-block: auto;
    block-size: fit-content;
  }

  /* Body grid */
  .dense-body {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    min-inline-size: 0;
    flex: 1;
    overflow: hidden;
  }

  /* Sidebar */
  .dense-sidebar {
    border-inline-end: 1px solid var(--pl-color-border);
    overflow-y: auto;
    padding: var(--pl-space-2);
    scrollbar-width: thin;
  }
  .dense-nav-group {
    margin-block-end: var(--pl-space-3);
  }
  .dense-nav-label {
    display: block;
    font-size: var(--pl-text-xs);
    font-weight: var(--pl-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--pl-color-text-muted);
    padding: var(--pl-space-1) var(--pl-space-2);
    margin-block-end: var(--pl-space-1);
  }
  .dense-nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pl-space-2);
    padding: var(--pl-space-1) var(--pl-space-2);
    border-radius: var(--pl-radius-sm);
    font-size: var(--pl-text-sm);
    color: var(--pl-color-text-muted);
    text-decoration: none;
    min-block-size: 1.75rem;
    transition: background-color var(--pl-duration-1) var(--pl-ease-standard);
  }
  .dense-nav-item:hover {
    background: var(--pl-color-surface-2);
    color: var(--pl-color-text);
  }
  .dense-nav-item.is-active {
    background: color-mix(in oklab, var(--pl-color-accent), transparent 88%);
    color: var(--pl-color-accent);
    font-weight: var(--pl-font-weight-medium);
  }

  /* Mini badge for nav counts */
  .pl-c-badge--mini {
    font-size: var(--pl-text-xs);
    padding-inline: var(--pl-space-1);
    min-block-size: 1rem;
    line-height: 1rem;
  }

  /* Main content */
  .dense-main {
    overflow-y: auto;
    padding: var(--pl-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--pl-space-3);
    min-inline-size: 0;
  }

  /* KPI strip */
  .dense-kpis {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--pl-space-2);
  }
  @media (width < 80rem) {
    .dense-kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (width < 48rem) {
    .dense-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Hotkeys strip */
  .dense-hotkeys {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--pl-space-1) var(--pl-space-2);
    background: color-mix(in oklab, var(--pl-color-surface), transparent 50%);
    border: 1px solid var(--pl-color-border);
    border-radius: var(--pl-radius-sm);
    font-size: var(--pl-text-xs);
  }
  .dense-hotkeys__group {
    display: flex;
    align-items: center;
    gap: var(--pl-space-3);
    flex-wrap: wrap;
  }
  .dense-hotkeys__label {
    color: var(--pl-color-text-muted);
    font-weight: var(--pl-font-weight-medium);
  }
  .dense-hotkeys__item {
    display: inline-flex;
    align-items: center;
    gap: var(--pl-space-1);
    color: var(--pl-color-text);
  }
  .dense-hotkeys__status {
    display: inline-flex;
    align-items: center;
    gap: var(--pl-space-1);
    color: var(--pl-color-text-muted);
    font-family: var(--pl-font-mono);
  }
  .dense-pulse {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--pl-color-success);
    display: inline-block;
  }

  /* Toolbar */
  .dense-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pl-space-3);
    flex-wrap: wrap;
  }
  .dense-toolbar__left,
  .dense-toolbar__right {
    display: flex;
    align-items: center;
    gap: var(--pl-space-2);
  }
  .dense-toolbar__count {
    font-size: var(--pl-text-xs);
    color: var(--pl-color-text-muted);
    white-space: nowrap;
  }

  /* Dense table overrides */
  .dense-table .pl-c-table td,
  .dense-table .pl-c-table th {
    font-size: var(--pl-text-sm);
  }
  .dense-table {
    max-inline-size: 100%;
  }
  .dense-mono {
    font-family: var(--pl-font-mono);
    font-size: var(--pl-text-xs);
    white-space: nowrap;
  }
  .dense-status {
    font-size: var(--pl-text-xs);
    font-weight: var(--pl-font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--pl-color-text-muted);
  }
  .dense-status--active { color: var(--pl-color-warning-text); }
  .dense-status--ack { color: var(--pl-color-accent); }
  .dense-status--resolved { color: var(--pl-color-success-text); }

  /* Pager */
  .dense-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--pl-space-3);
  }
  .dense-pager__ellipsis {
    font-size: var(--pl-text-sm);
    color: var(--pl-color-text-muted);
    padding-inline: var(--pl-space-1);
  }

  @media (width < 48rem) {
    .dense-app {
      block-size: auto;
      min-block-size: 100dvh;
      inline-size: calc(100% + (2 * var(--pl-space-4)));
      margin: calc(-1 * var(--pl-space-4));
      overflow: visible;
    }

    .dense-topbar {
      flex-wrap: wrap;
      align-items: stretch;
      gap: var(--pl-space-2);
      padding: var(--pl-space-2);
    }

    .dense-search {
      order: 3;
      flex: 1 0 100%;
      min-inline-size: 0;
      max-inline-size: none;
    }

    .dense-topbar__right {
      margin-inline-start: auto;
    }

    .dense-body {
      display: block;
      overflow: visible;
    }

    .dense-sidebar {
      display: none;
    }

    .dense-main {
      overflow: visible;
      padding: var(--pl-space-2);
    }

    .dense-kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dense-toolbar,
    .dense-pager {
      align-items: stretch;
    }

    .dense-toolbar__left,
    .dense-toolbar__right,
    .dense-pager .pl-c-pagination {
      overflow-x: auto;
      max-inline-size: 100%;
      scrollbar-width: thin;
    }

    .dense-pager {
      flex-direction: column;
    }
  }

  .dense-body[data-sidebar="collapsed"] {
    grid-template-columns: minmax(0, 1fr);
  }
  .dense-body[data-sidebar="collapsed"] .dense-sidebar {
    display: none;
  }
</style>

<script>
  document.querySelector('[data-toggle="sidebar"]')?.addEventListener('click', () => {
    const body = document.querySelector('.dense-body');
    const collapsed = body?.getAttribute('data-sidebar') === 'collapsed';
    body?.setAttribute('data-sidebar', collapsed ? 'expanded' : 'collapsed');
  });
</script>
