---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rows = Array.from({ length: 18 }, (_, i) => i + 1);
---
<BaseLayout title="Scroll Region · Porchlight">
  <h1>Scroll Region</h1>
  <p>Accent edges indicate more content in that direction. Scroll both axes to distinguish pinned headers and the case column. Tab to a region and use arrow keys.</p>
  <h2 id="cases-title">Case queue</h2>
  <div class="pl-l-stack" style="--pl-l-stack-gap: var(--pl-space-3);">
  <div id="queue" class="pl-c-table-wrap pl-c-scroll-region" tabindex="0" role="region" aria-labelledby="cases-title">
    <table class="pl-c-table">
      <thead><tr><th class="pl-c-table__sticky-col" scope="col">Case</th><th scope="col">Summary</th><th scope="col">Owner</th><th scope="col">Updated</th></tr></thead>
      <tbody>{rows.map(i => <tr><td class="pl-c-table__sticky-col"><a href="#case-detail">CASE-{i}</a></td><td>Suspicious sign-in requires investigation</td><td>Security operations</td><td>September 27, 2026</td></tr>)}</tbody>
    </table>
  </div>
  <p id="case-detail" style="margin: 0;">Case links remain accessible beneath the non-interactive edge indicators.</p>
  </div>
  <h2 id="short-title">No overflow</h2>
  <div id="short" class="pl-c-scroll-region" tabindex="0" role="region" aria-labelledby="short-title" style="--pl-c-scroll-region-size: 8rem;">
    <div class="pl-l-stack" style="padding: var(--pl-space-4);"><strong>All caught up</strong><span>No accent edges when everything fits.</span></div>
  </div>
</BaseLayout>
