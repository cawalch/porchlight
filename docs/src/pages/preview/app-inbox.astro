---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewToolbar from '../../components/PreviewToolbar.astro';

const folders = [
  { label: 'Inbox', active: true, badge: '4' },
  { label: 'Starred', badge: '2' },
  { label: 'Sent' },
  { label: 'Drafts' },
  { label: 'Archive' },
];

const messages = [
  { sender: 'Sarah Chen', subject: 'Re: Q3 Roadmap Review', preview: 'I reviewed the proposal and I think we should prioritize the...', time: '9:42 AM', unread: true, starred: true },
  { sender: 'Marcus Webb', subject: 'Deployment succeeded - v2.4.1', preview: 'All services are running. The migration completed without...', time: '8:15 AM', unread: true, starred: false },
  { sender: 'Lisa Park', subject: 'New integration request', preview: 'Hi team, we have a client asking about Salesforce...', time: 'Yesterday', unread: true, starred: false },
  { sender: 'Tom Anderson', subject: 'Weekly status report', preview: 'Here is the summary for this week. Key wins include...', time: 'Yesterday', unread: false },
  { sender: 'GitHub', subject: '[porchlight] PR #33 merged', preview: 'The PR "feat: layout extensions" has been merged into main.', time: '2 days ago', unread: true },
  { sender: 'Anna Lee', subject: 'Design review feedback', preview: 'The new component library looks great. A few notes on...', time: '3 days ago', unread: false },
];
---
<BaseLayout title="Responsive inbox · Porchlight">
  <PreviewToolbar title="Responsive Communication Inbox" />
  <h1>Responsive inbox</h1>
  <p>
    A master-detail inbox layout. The <code>.pl-l-sidebar</code> collapses to
    a single column when the container is narrow (container query, not
    viewport). The list and detail use framework primitives only.
  </p>

  <div class="pl-l-sidebar" style="--pl-l-sidebar-size: 14rem;">
    <nav class="pl-c-nav" aria-label="Mail folders">
      {folders.map((folder) => (
        <a href="#" class="pl-c-nav__item" aria-current={folder.active ? 'page' : undefined}>
          <svg class="pl-c-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 4h16v16H4z" stroke-linejoin="round"></path>
            <path d="m4 4 8 8 8-8"></path>
          </svg>
          <span class="pl-c-nav__label">{folder.label}</span>
          {folder.badge && <span class="pl-c-badge pl-c-nav__badge" data-tone={folder.active ? 'accent' : undefined}>{folder.badge}</span>}
        </a>
      ))}
    </nav>

    <div class="pl-l-sidebar" style="--pl-l-sidebar-size: 20rem;">
      <div class="pl-c-card" data-surface="app" data-variant="flush">
        <div class="pl-c-toolbar">
          <label class="pl-c-field pl-c-field--inline" style="flex: 1;">
            <span class="pl-u-sr-only">Search messages</span>
            <input class="pl-c-field__control" type="search" placeholder="Search inbox..." aria-label="Search inbox" />
          </label>
        </div>
        <div class="pl-c-table-wrap" tabindex="0">
          <table class="pl-c-table">
            <caption class="pl-u-sr-only">Inbox messages</caption>
            <thead>
              <tr>
                <th>Message</th>
                <th data-align="end">Received</th>
              </tr>
            </thead>
            <tbody>
              {messages.map((message, index) => (
                <tr aria-selected={index === 0 ? 'true' : undefined}>
                  <td>
                    <strong>{message.starred ? '★ ' : ''}{message.sender}</strong>
                    <span class="pl-u-muted-sm">{message.subject}</span>
                    <span class="pl-u-muted-sm">{message.preview}</span>
                  </td>
                  <td data-align="end">
                    <span class="pl-u-muted-sm">{message.time}</span>
                    {message.unread && <span class="pl-c-badge" data-tone="accent">Unread</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="pl-c-card" data-surface="app" data-inbox-detail>
        <div class="pl-c-page-header">
          <div class="pl-c-page-header__heading">
            <h2 class="pl-c-page-header__title">Re: Q3 Roadmap Review</h2>
            <span class="pl-c-page-header__subtitle">Sarah Chen · sarah@example.com</span>
          </div>
          <div class="pl-c-page-header__actions">
            <button class="pl-c-button" data-variant="ghost" data-size="sm">Star</button>
            <button class="pl-c-button" data-variant="ghost" data-size="sm">Archive</button>
          </div>
        </div>
        <div class="pl-c-card__body pl-l-stack" style="--pl-l-stack-gap: var(--pl-space-3);">
          <p>Hi team,</p>
          <p>
            I reviewed the Q3 proposal and the sequencing looks right. I would
            prioritize the retention work before the reporting refresh, because
            the audit surface is already the trust anchor for the quarter.
          </p>
          <p>
            One note: keep the rollout checklist visible on the incident review
            page. The last review lost time because the runbook link was buried.
          </p>
          <p>Thanks,<br />Sarah</p>
          <div class="pl-l-cluster" style="--pl-l-cluster-gap: var(--pl-space-2);">
            <button class="pl-c-button" data-variant="primary" data-size="sm">Reply</button>
            <button class="pl-c-button" data-variant="secondary" data-size="sm">Forward</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
