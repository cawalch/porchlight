---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Property List · Porchlight">
  <h1>Property List</h1>
  <p>
    High-density key-value metadata list designed for cloud resource inspectors,
    account profiles, and operational telemetry cards. Supports subgrid track
    inheritance, copy-to-clipboard buttons, and density modes.
  </p>

  <h2>Standard Inspector Bay</h2>
  <div class="pl-c-card" style="max-inline-size: 32rem;">
    <div class="pl-c-card__header">
      <h3 class="pl-c-card__title">Cluster Specifications</h3>
      <span class="pl-c-badge" data-tone="success">Healthy</span>
    </div>
    <div class="pl-c-card__body">
      <dl class="pl-c-property-list" data-pl-density="compact" data-dividers="true">
        <div class="pl-c-property-list__item">
          <dt class="pl-c-property-list__key">Cluster UUID</dt>
          <dd class="pl-c-property-list__value">
            <code class="pl-c-property-list__mono">cls_99182a0fbc</code>
            <button type="button" class="pl-c-property-list__copy" aria-label="Copy Cluster UUID">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
            </button>
          </dd>
        </div>
        <div class="pl-c-property-list__item">
          <dt class="pl-c-property-list__key">Region</dt>
          <dd class="pl-c-property-list__value">
            <span>us-east-1 (N. Virginia)</span>
          </dd>
        </div>
        <div class="pl-c-property-list__item">
          <dt class="pl-c-property-list__key">VPC CIDR</dt>
          <dd class="pl-c-property-list__value">
            <code class="pl-c-property-list__mono">10.240.0.0/16</code>
          </dd>
        </div>
        <div class="pl-c-property-list__item">
          <dt class="pl-c-property-list__key">Active Nodes</dt>
          <dd class="pl-c-property-list__value">
            <span class="pl-u-tabular-nums">12 of 16 running</span>
          </dd>
        </div>
        <div class="pl-c-property-list__item">
          <dt class="pl-c-property-list__key">Created At</dt>
          <dd class="pl-c-property-list__value">
            <time datetime="2026-11-01T07:00:00Z" class="pl-c-property-list__mono">2026-11-01 07:00:00 UTC</time>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <h2>Density Modes</h2>
  <div class="pl-l-grid" style="--pl-l-grid-min: 18rem; gap: var(--pl-space-4);">
    <div class="pl-c-card">
      <div class="pl-c-card__header">
        <h3 class="pl-c-card__title">Dense Mode</h3>
      </div>
      <div class="pl-c-card__body">
        <dl class="pl-c-property-list" data-pl-density="dense" data-dividers="true">
          <div class="pl-c-property-list__item">
            <dt class="pl-c-property-list__key">P99 Latency</dt>
            <dd class="pl-c-property-list__value"><span class="pl-u-tabular-nums">1.42 ms</span></dd>
          </div>
          <div class="pl-c-property-list__item">
            <dt class="pl-c-property-list__key">Error Budget</dt>
            <dd class="pl-c-property-list__value"><span class="pl-u-tabular-nums">99.982%</span></dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="pl-c-card">
      <div class="pl-c-card__header">
        <h3 class="pl-c-card__title">Comfortable Mode</h3>
      </div>
      <div class="pl-c-card__body">
        <dl class="pl-c-property-list" data-pl-density="comfortable" data-dividers="true">
          <div class="pl-c-property-list__item">
            <dt class="pl-c-property-list__key">Billing Owner</dt>
            <dd class="pl-c-property-list__value">infra-team@acme.corp</dd>
          </div>
          <div class="pl-c-property-list__item">
            <dt class="pl-c-property-list__key">Tier</dt>
            <dd class="pl-c-property-list__value"><span class="pl-c-badge" data-tone="accent">Enterprise</span></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</BaseLayout>
