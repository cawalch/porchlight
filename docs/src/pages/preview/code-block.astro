---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Code Block · Porchlight">
  <h1>Code Block</h1>
  <p>
    Developer-grade code and diff viewer shell with architectural header bar,
    pure-CSS line numbers, copy actions, and unified diff line highlights.
  </p>

  <h2>Standard Code Viewer with Line Numbers</h2>
  <div class="pl-c-code-block" data-language="json" data-line-numbers="true">
    <div class="pl-c-code-block__header">
      <div class="pl-c-code-block__meta">
        <span class="pl-c-code-block__title">telemetry-config.json</span>
        <span class="pl-c-badge" data-size="sm">JSON</span>
      </div>
      <button type="button" class="pl-c-code-block__copy" aria-label="Copy telemetry-config.json">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
        <span>Copy</span>
      </button>
    </div>
    <pre class="pl-c-code-block__pre"><code class="pl-c-code-block__code"><span class="pl-c-code-block__line">&#123;</span>
<span class="pl-c-code-block__line">  "service": "porchlight-telemetry",</span>
<span class="pl-c-code-block__line">  "cluster": "node-cluster-09",</span>
<span class="pl-c-code-block__line">  "sample_rate": 0.05,</span>
<span class="pl-c-code-block__line">  "export_protocol": "otlp/grpc"</span>
<span class="pl-c-code-block__line">&#125;</span></code></pre>
  </div>

  <h2>Unified Diff Highlighting</h2>
  <div class="pl-c-code-block" data-language="diff" data-line-numbers="true">
    <div class="pl-c-code-block__header">
      <div class="pl-c-code-block__meta">
        <span class="pl-c-code-block__title">security-policy.diff</span>
        <span class="pl-c-badge" data-size="sm" data-tone="warning">DIFF</span>
      </div>
      <button type="button" class="pl-c-code-block__copy" aria-label="Copy security-policy.diff">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
        <span>Copy</span>
      </button>
    </div>
    <pre class="pl-c-code-block__pre"><code class="pl-c-code-block__code"><span class="pl-c-code-block__line">  "apiVersion": "security.porchlight.dev/v1",</span>
<span class="pl-c-code-block__line">  "kind": "ClusterPolicy",</span>
<span class="pl-c-code-block__line" data-diff="remove">- "enforceMode": "permissive",</span>
<span class="pl-c-code-block__line" data-diff="add">+ "enforceMode": "strict",</span>
<span class="pl-c-code-block__line" data-diff="remove">- "maxLeaseDurationSeconds": 86400,</span>
<span class="pl-c-code-block__line" data-diff="add">+ "maxLeaseDurationSeconds": 3600,</span>
<span class="pl-c-code-block__line">  "auditTrail": true</span></code></pre>
  </div>
</BaseLayout>
