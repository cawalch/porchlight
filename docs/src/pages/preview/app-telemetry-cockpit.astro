---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewToolbar from '../../components/PreviewToolbar.astro';

const kpis = [
  { label: 'Cluster saturation', value: '78', unit: '%', tone: 'warning', trend: '+6%' },
  { label: 'Error budget', value: '42', unit: '%', tone: 'danger', trend: '-18%' },
  { label: 'p95 latency', value: '184', unit: 'ms', tone: 'success', trend: '-12ms' },
  { label: 'Open incidents', value: '3', unit: '', tone: 'accent', trend: '+1' },
];

const audit = [
  { actor: 'SRE', action: 'DRAINED NODE', target: 'gke-prod-pool-7', time: '12:42:18', tone: 'warning' },
  { actor: 'AUTOSCALER', action: 'SCALED', target: 'checkout-api 24 → 31', time: '12:41:02', tone: 'success' },
  { actor: 'ONCALL', action: 'ACKNOWLEDGED', target: 'INC-4821', time: '12:38:44', tone: 'accent' },
  { actor: 'POLICY', action: 'BLOCKED', target: 'image:latest deploy', time: '12:36:10', tone: 'danger' },
  { actor: 'SRE', action: 'ROLLBACK', target: 'app:1.9.0 → 1.8.2', time: '12:34:55', tone: 'success' },
  { actor: 'AUDIT', action: 'SIGNED', target: 'change-8841', time: '12:30:12', tone: 'neutral' },
];
---
<BaseLayout title="Cloud Telemetry & Incident War Room · Porchlight" palette="midnight" density="dense" theme="dark">
  <PreviewToolbar palette="midnight" theme="dark" density="dense" title="Cloud Telemetry & Incident War Room" />
  <div
    class="pl-l-container pl-l-stack"
    style="--pl-l-container-max: 88rem; --pl-l-stack-gap: var(--pl-space-5); padding-block: var(--pl-space-6);"
  >
    <div class="pl-c-page-header">
      <div class="pl-c-page-header__heading">
        <h1 class="pl-c-page-header__title">Telemetry Cockpit</h1>
        <span class="pl-c-page-header__subtitle">Production signals, incident state, and the audit trail</span>
      </div>
      <div class="pl-c-page-header__actions">
        <label class="pl-c-field pl-c-field--inline pl-c-field--search">
          <span class="pl-u-sr-only">Query telemetry</span>
          <input class="pl-c-field__control cockpit-query-input" type="search" placeholder="Query traces, hosts, or services" />
        </label>
        <button class="pl-c-button" data-variant="secondary" data-size="sm">Export</button>
        <button class="pl-c-button" data-variant="primary" data-size="sm">Declare incident</button>
      </div>
    </div>

    <div class="pl-c-banner" data-tone="warning">
      <div class="pl-c-banner__content">
        <div class="pl-c-banner__main">
          <div class="pl-c-banner__message">
            <strong>Error budget burn is above the 1-hour threshold.</strong>
            <span class="pl-u-muted-sm">Checkout is the largest contributor. The rollback runbook is ready.</span>
          </div>
        </div>
        <div class="pl-c-banner__actions">
          <kbd class="pl-c-kbd">R</kbd><kbd class="pl-c-kbd">U</kbd><kbd class="pl-c-kbd">N</kbd>
        </div>
      </div>
    </div>

    <div class="pl-l-grid" style="--pl-l-grid-min: 14rem; --pl-l-grid-gap: var(--pl-space-3);">
      {kpis.map((kpi) => (
        <article class="pl-c-kpi-card" data-tone={kpi.tone}>
          <header class="pl-c-kpi-card__header">
            <span class="pl-c-kpi-card__label">{kpi.label}</span>
            <span class="pl-c-badge" data-tone={kpi.tone}>{kpi.trend}</span>
          </header>
          <div class="pl-c-kpi-card__metric">
            <span class="pl-c-kpi-card__value pl-u-tabular-nums">{kpi.value}</span>
            {kpi.unit && <span class="pl-c-kpi-card__suffix">{kpi.unit}</span>}
          </div>
          <footer class="pl-c-kpi-card__footer">
            <span class="pl-u-muted-sm">vs previous 30m</span>
          </footer>
        </article>
      ))}
    </div>

    <div class="pl-c-split-pane cockpit-split" data-orientation="horizontal" data-collapse="stack">
      <section class="pl-c-split-pane__pane pl-c-split-pane__pane--start">
        <div class="pl-c-split-pane__header">
          <h2 class="pl-c-split-pane__title">Immutable audit stream</h2>
        </div>
        <div class="pl-c-split-pane__pane-inner">
          <ol class="pl-c-audit-stream" role="list" aria-label="Audit stream">
            {audit.map((event) => (
              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">{event.actor.slice(0, 2)}</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">{event.actor}</span>
                    <span class="pl-c-badge" data-tone={event.tone} data-size="sm">{event.action}</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">{event.time}</time>
                  </div>
                  <div class="pl-c-audit-stream__target"><code class="pl-c-audit-stream__mono">{event.target}</code></div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <div class="pl-c-split-pane__separator" aria-hidden="true"></div>

      <section class="pl-c-split-pane__pane pl-c-split-pane__pane--end">
        <div class="pl-c-split-pane__header">
          <h2 class="pl-c-split-pane__title">Node inspector</h2>
        </div>
        <div class="pl-c-split-pane__pane-inner pl-l-stack" style="--pl-l-stack-gap: var(--pl-space-3);">
          <dl class="pl-c-property-list" data-subgrid="true">
            <div class="pl-c-property-list__item">
              <dt class="pl-c-property-list__key">Cluster</dt>
              <dd class="pl-c-property-list__value"><code class="pl-c-property-list__mono">prod-us-central</code></dd>
            </div>
            <div class="pl-c-property-list__item">
              <dt class="pl-c-property-list__key">Node pool</dt>
              <dd class="pl-c-property-list__value">checkout-pool-7</dd>
            </div>
            <div class="pl-c-property-list__item">
              <dt class="pl-c-property-list__key">Saturation</dt>
              <dd class="pl-c-property-list__value pl-u-tabular-nums">78%</dd>
            </div>
          </dl>

          <div class="pl-c-code-block" data-language="yaml" data-line-numbers="true">
            <div class="pl-c-code-block__header">
              <div class="pl-c-code-block__meta">
                <span class="pl-c-code-block__title">rollback.yaml</span>
              </div>
            </div>
            <pre class="pl-c-code-block__pre"><code class="pl-c-code-block__code"><span class="pl-c-code-block__line" data-line="1">service: checkout-api</span>
<span class="pl-c-code-block__line" data-line="2">from: app:1.9.0</span>
<span class="pl-c-code-block__line" data-line="3">to: app:1.8.2</span></code></pre>
          </div>
          <div class="pl-l-cluster" style="--pl-l-cluster-gap: var(--pl-space-2);">
            <kbd class="pl-c-kbd">⌘</kbd><kbd class="pl-c-kbd">⇧</kbd><kbd class="pl-c-kbd">R</kbd>
            <span class="pl-u-muted-sm">Run rollback</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
