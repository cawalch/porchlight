---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Telemetry Cockpit · Porchlight">
  <!-- Pinned Top Incident Banner with Scroll-State Active Horizon Elevation -->
  <aside class="pl-c-banner" data-tone="warning" data-sticky="true" role="region" aria-label="Active migration warning">
    <div class="pl-c-banner__content">
      <div class="pl-c-banner__main">
        <span class="pl-c-banner__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
            <line x1="12" y1="9" x2="12" y2="13" />
            <line x1="12" y1="17" x2="12.01" y2="17" />
          </svg>
        </span>
        <div class="pl-c-banner__message">
          <strong>Cluster Partition Advisory:</strong> Node pool <code class="pl-u-mono">np-compute-4</code> is undergoing automated drain &amp; rebalancing. Ingestion telemetry is running on secondary failover partition <span class="pl-u-tabular-nums">us-east-2b</span>.
        </div>
      </div>
      <div class="pl-c-banner__actions">
        <button type="button" class="pl-c-banner__close" aria-label="Dismiss migration alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </aside>

  <!-- Sticky Cockpit Navigation Toolbar -->
  <header class="pl-c-toolbar" data-sticky="true" data-surface="flush" style="border-block-end: 1px solid var(--pl-color-border); margin-block-end: var(--pl-space-4);">
    <div class="pl-c-toolbar__group" style="align-items: center; gap: var(--pl-space-2);">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="12 2 2 7 12 12 22 7 12 2" />
        <polyline points="2 17 12 22 22 17" />
        <polyline points="2 12 12 17 22 12" />
      </svg>
      <div>
        <h1 style="font-size: var(--pl-text-sm); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; margin: 0; line-height: 1.2;">
          Telemetry Cockpit
        </h1>
        <div class="pl-u-muted" style="font-size: var(--pl-text-xs); font-family: var(--pl-font-mono);">
          REGION: US-EAST-2 // CLUSTER: ALPHA-09
        </div>
      </div>
      <span class="pl-c-badge" data-tone="success">HEALTHY</span>
    </div>

    <!-- Center: Elastic IDE Query Input -->
    <div class="pl-c-toolbar__group" style="flex: 1 1 12rem; max-width: 440px; min-inline-size: 0;">
      <div style="display: flex; align-items: center; width: 100%; gap: var(--pl-space-2); min-inline-size: 0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pl-u-muted" aria-hidden="true" style="flex-shrink: 0;">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="text"
          class="pl-c-field__input"
          data-elastic="true"
          placeholder="Filter metrics, actors, policy (field-sizing: content)..."
          value="service:ingress status:quarantined"
          aria-label="Filter telemetry metrics and actors"
          style="font-family: var(--pl-font-mono); font-size: var(--pl-text-xs); padding: var(--pl-space-1) var(--pl-space-2); min-inline-size: 0; width: 100%; max-inline-size: 100%;"
        />
      </div>
    </div>

    <!-- Right: Hotkey Trigger and Actions -->
    <div class="pl-c-toolbar__group" style="align-items: center; gap: var(--pl-space-2);">
      <button type="button" class="pl-c-button" data-variant="ghost" data-size="sm">
        <kbd class="pl-c-kbd">⌘</kbd><kbd class="pl-c-kbd">K</kbd>
      </button>
      <button type="button" class="pl-c-button" data-variant="secondary" data-size="sm">
        Export Audit
      </button>
      <button type="button" class="pl-c-button" data-variant="primary" data-size="sm">
        Apply Policy
      </button>
    </div>
  </header>

  <div class="pl-l-flow" style="max-width: 1440px; margin-inline: auto;">
    <!-- Telemetry KPI Dashboard Tiles -->
    <section aria-labelledby="kpi-heading">
      <h2 id="kpi-heading" class="pl-u-sr-only">Telemetry Key Performance Indicators</h2>
      <div class="pl-l-grid" style="--pl-l-grid-min: 220px; gap: var(--pl-space-3);">
        <!-- Metric 1: Error Budget -->
        <article class="pl-c-kpi-card" data-tone="accent">
          <header class="pl-c-kpi-card__header">
            <span class="pl-c-kpi-card__label">Error Budget SLA</span>
            <span class="pl-c-badge" data-tone="accent">99.9% Target</span>
          </header>
          <div class="pl-c-kpi-card__metric">
            <span class="pl-c-kpi-card__value">99.982</span>
            <span class="pl-c-kpi-card__suffix">%</span>
          </div>
          <footer class="pl-c-kpi-card__footer">
            <span class="pl-c-kpi-card__delta" data-tone="success" data-direction="up">
              +0.014%
            </span>
            <span class="pl-c-kpi-card__comparison">vs rolling 30d epoch</span>
          </footer>
          <div class="pl-c-kpi-card__sparkline" aria-hidden="true">
            <svg viewBox="0 0 100 24" preserveAspectRatio="none" style="width: 100%; height: 28px; stroke: var(--pl-color-success); fill: none; stroke-width: 2;">
              <polyline points="0,20 15,18 30,19 45,12 60,14 75,8 90,6 100,4" />
            </svg>
          </div>
        </article>

        <!-- Metric 2: P99 Latency -->
        <article class="pl-c-kpi-card" data-tone="success">
          <header class="pl-c-kpi-card__header">
            <span class="pl-c-kpi-card__label">P99 Gateway Latency</span>
            <span class="pl-c-badge" data-tone="success">Optimal</span>
          </header>
          <div class="pl-c-kpi-card__metric">
            <span class="pl-c-kpi-card__value">14.8</span>
            <span class="pl-c-kpi-card__suffix">ms</span>
          </div>
          <footer class="pl-c-kpi-card__footer">
            <span class="pl-c-kpi-card__delta" data-tone="success" data-direction="down">
              -3.2ms
            </span>
            <span class="pl-c-kpi-card__comparison">vs peak threshold</span>
          </footer>
          <div class="pl-c-kpi-card__sparkline" aria-hidden="true">
            <svg viewBox="0 0 100 24" preserveAspectRatio="none" style="width: 100%; height: 28px; stroke: var(--pl-color-success); fill: none; stroke-width: 2;">
              <polyline points="0,6 15,9 30,8 45,14 60,11 75,18 90,16 100,20" />
            </svg>
          </div>
        </article>

        <!-- Metric 3: Ingestion Throughput -->
        <article class="pl-c-kpi-card" data-tone="accent">
          <header class="pl-c-kpi-card__header">
            <span class="pl-c-kpi-card__label">Ingestion Throughput</span>
            <span class="pl-c-badge" data-tone="accent">Real-time</span>
          </header>
          <div class="pl-c-kpi-card__metric">
            <span class="pl-c-kpi-card__value">2.41</span>
            <span class="pl-c-kpi-card__suffix">M/s</span>
          </div>
          <footer class="pl-c-kpi-card__footer">
            <span class="pl-c-kpi-card__delta" data-tone="accent" data-direction="up">
              +8.6%
            </span>
            <span class="pl-c-kpi-card__comparison">events committed</span>
          </footer>
          <div class="pl-c-kpi-card__sparkline" aria-hidden="true">
            <svg viewBox="0 0 100 24" preserveAspectRatio="none" style="width: 100%; height: 28px; stroke: var(--pl-color-accent); fill: none; stroke-width: 2;">
              <polyline points="0,18 15,16 30,17 45,11 60,13 75,7 90,9 100,5" />
            </svg>
          </div>
        </article>

        <!-- Metric 4: Quarantined Pods -->
        <article class="pl-c-kpi-card" data-tone="danger">
          <header class="pl-c-kpi-card__header">
            <span class="pl-c-kpi-card__label">Fault Containment</span>
            <span class="pl-c-badge" data-tone="danger">Action Required</span>
          </header>
          <div class="pl-c-kpi-card__metric">
            <span class="pl-c-kpi-card__value">3</span>
            <span class="pl-c-kpi-card__suffix">pods</span>
          </div>
          <footer class="pl-c-kpi-card__footer">
            <span class="pl-c-kpi-card__delta" data-tone="danger" data-direction="up">
              +2
            </span>
            <span class="pl-c-kpi-card__comparison">quarantined in last 1h</span>
          </footer>
          <div class="pl-c-kpi-card__sparkline" aria-hidden="true">
            <svg viewBox="0 0 100 24" preserveAspectRatio="none" style="width: 100%; height: 28px; stroke: var(--pl-color-danger); fill: none; stroke-width: 2;">
              <polyline points="0,22 20,22 40,22 60,14 80,14 100,4" />
            </svg>
          </div>
        </article>
      </div>
    </section>

    <!-- Cockpit Workstation Split Pane with CSS Gap Decorations (rule) -->
    <section aria-labelledby="cockpit-workstation-heading">
      <h2 id="cockpit-workstation-heading" class="pl-u-sr-only">Cockpit Workstation: Audit Stream and Node Inspector</h2>
      <div class="pl-c-split-pane" data-orientation="horizontal" data-collapse="stack" data-dividers="true" style="border: 1px solid var(--pl-color-border); border-radius: var(--pl-radius-md); background: var(--pl-color-surface);">
        <!-- Left Pane: Enterprise Compliance Audit Ledger -->
        <section class="pl-c-split-pane__pane pl-c-split-pane__pane--start" aria-label="Enterprise Audit Ledger">
          <div class="pl-c-split-pane__pane-inner" style="padding: var(--pl-space-4);">
            <header class="pl-l-cluster" style="justify-content: space-between; align-items: center; margin-block-end: var(--pl-space-3);">
              <div class="pl-l-cluster" style="align-items: center; gap: var(--pl-space-2);">
                <h3 style="font-size: var(--pl-text-sm); font-weight: 700; margin: 0; text-transform: uppercase; letter-spacing: 0.04em;">
                  Enterprise Audit Ledger
                </h3>
                <span class="pl-c-badge" data-tone="accent">IMMUTABLE SOC-2</span>
              </div>
              <span class="pl-u-muted pl-u-tabular-nums" style="font-size: var(--pl-text-xs); font-family: var(--pl-font-mono);">
                SYNC: 14:38:02.114 UTC
              </span>
            </header>

            <ol class="pl-c-audit-stream">
              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">OP</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">k8s-operator/controller</span>
                    <span class="pl-c-badge" data-tone="danger">QUARANTINE</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">14:38:02.114</time>
                  </div>
                  <div class="pl-c-audit-stream__summary">
                    Quarantined node container <code class="pl-u-mono">compute-pool-04-node-b</code> after detecting high burst signature anomaly matching rate limit trigger.
                  </div>
                </div>
              </li>

              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">MP</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">sec-eng/m.patel</span>
                    <span class="pl-c-badge" data-tone="warning">PERIMETER RULE</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">14:35:19.450</time>
                  </div>
                  <div class="pl-c-audit-stream__summary">
                    Applied emergency perimeter CIDR isolation to inbound ingress routes on gateway <code class="pl-u-mono">gw-ingress-02</code>.
                  </div>
                </div>
              </li>

              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">CI</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">ci-bot/pipeline</span>
                    <span class="pl-c-badge" data-tone="accent">CANARY DEPLOY</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">14:31:00.892</time>
                  </div>
                  <div class="pl-c-audit-stream__summary">
                    Canary release <code class="pl-u-mono">v2.18.0-rc4</code> successfully validated across partition 09 with 0 synthetic test regression.
                  </div>
                </div>
              </li>

              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">VT</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">iam-service/vault</span>
                    <span class="pl-c-badge" data-tone="success">KEY ROTATION</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">14:26:44.205</time>
                  </div>
                  <div class="pl-c-audit-stream__summary">
                    Auto-rotated mutual TLS client wildcards for cluster mesh communication. Re-handshake verified.
                  </div>
                </div>
              </li>

              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">CA</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">compliance/auditor</span>
                    <span class="pl-c-badge" data-tone="default">LEDGER SEAL</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">14:20:12.780</time>
                  </div>
                  <div class="pl-c-audit-stream__summary">
                    Sealed cryptographic audit epoch. Merkle tree root hash registered with corporate immutable ledger.
                  </div>
                </div>
              </li>
            </ol>
          </div>
        </section>

        <!-- Vertical Separator -->
        <div class="pl-c-split-pane__separator" role="separator" aria-orientation="vertical"></div>

        <!-- Right Pane: Active Node Inspector & Architectural Property List -->
        <section class="pl-c-split-pane__pane pl-c-split-pane__pane--end" aria-label="Active Node Inspector" style="background: var(--pl-color-surface-2);">
          <div class="pl-c-split-pane__pane-inner" style="padding: var(--pl-space-4);">
            <header class="pl-l-cluster" style="justify-content: space-between; align-items: center; margin-block-end: var(--pl-space-3);">
              <h3 style="font-size: var(--pl-text-sm); font-weight: 700; margin: 0; text-transform: uppercase; letter-spacing: 0.04em;">
                Node Inspector // Subgrid Specs
              </h3>
              <span class="pl-c-badge" data-tone="warning">QUARANTINED</span>
            </header>

            <!-- Property List using CSS Subgrid -->
            <dl class="pl-c-property-list" data-subgrid="true" data-pl-density="dense" style="margin-block-end: var(--pl-space-4);">
              <div class="pl-c-property-list__item">
                <dt class="pl-c-property-list__key">Host Identifier</dt>
                <dd class="pl-c-property-list__value pl-u-mono">prod-telemetry-worker-08</dd>
              </div>
              <div class="pl-c-property-list__item">
                <dt class="pl-c-property-list__key">Kernel Version</dt>
                <dd class="pl-c-property-list__value pl-u-mono pl-u-tabular-nums">Linux 6.8.12-hardened-x86_64</dd>
              </div>
              <div class="pl-c-property-list__item">
                <dt class="pl-c-property-list__key">Memory Allocation</dt>
                <dd class="pl-c-property-list__value pl-u-tabular-nums">128.0 GiB (74.2% committed)</dd>
              </div>
              <div class="pl-c-property-list__item">
                <dt class="pl-c-property-list__key">Cipher Protocol</dt>
                <dd class="pl-c-property-list__value pl-u-mono">TLS_AES_256_GCM_SHA384</dd>
              </div>
              <div class="pl-c-property-list__item">
                <dt class="pl-c-property-list__key">Cryptographic Seal</dt>
                <dd class="pl-c-property-list__value pl-u-mono" style="font-size: var(--pl-text-xs);">
                  <span>0x4f88e1a99b2c3d</span>
                  <button type="button" class="pl-c-property-list__copy" aria-label="Copy hash value">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>
                </dd>
              </div>
            </dl>

            <!-- Monospaced Code Block with Architectural Header and Diff Styling -->
            <div class="pl-c-code-block" data-language="yaml" data-line-numbers="true">
              <div class="pl-c-code-block__header">
                <div class="pl-c-code-block__meta">
                  <span class="pl-c-code-block__title">security-policy-rule.yaml</span>
                  <span class="pl-c-badge" data-size="sm">YAML</span>
                </div>
                <button type="button" class="pl-c-code-block__copy" aria-label="Copy security-policy-rule.yaml">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
                  <span>Copy</span>
                </button>
              </div>
              <pre class="pl-c-code-block__pre" tabindex="0" aria-label="Security policy specification"><code class="pl-c-code-block__code"><span class="pl-c-code-block__line">apiVersion: telemetry.security/v2</span>
<span class="pl-c-code-block__line">kind: DynamicIngressPolicy</span>
<span class="pl-c-code-block__line">metadata:</span>
<span class="pl-c-code-block__line">  name: cluster-perimeter-guard</span>
<span class="pl-c-code-block__line">spec:</span>
<span class="pl-c-code-block__line" data-diff="remove">-  rateLimitWindowMs: 1000</span>
<span class="pl-c-code-block__line" data-diff="remove">-  maxBurstConnections: 500</span>
<span class="pl-c-code-block__line" data-diff="add">+  rateLimitWindowMs: 250</span>
<span class="pl-c-code-block__line" data-diff="add">+  maxBurstConnections: 120</span>
<span class="pl-c-code-block__line" data-diff="add">+  quarantineOnExceed: true</span></code></pre>
            </div>
          </div>
        </section>
      </div>
    </section>

    <!-- Tactile Keyboard Shortcuts Strip -->
    <footer class="pl-c-card" data-variant="flat" style="padding: var(--pl-space-3); margin-block: var(--pl-space-4); overflow: hidden;">
      <div class="pl-l-cluster" style="justify-content: space-between; align-items: center; font-size: var(--pl-text-xs);">
        <div class="pl-l-cluster" style="align-items: center; gap: var(--pl-space-3);">
          <span class="pl-u-muted" style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Tactile Keycaps</span>
          <span class="pl-l-cluster" style="align-items: center; gap: var(--pl-space-1);">
            <kbd class="pl-c-kbd">⌘</kbd><kbd class="pl-c-kbd">K</kbd> Command Palette
          </span>
          <span class="pl-l-cluster" style="align-items: center; gap: var(--pl-space-1);">
            <kbd class="pl-c-kbd">⇧</kbd><kbd class="pl-c-kbd">D</kbd> Toggle Raw Diff
          </span>
          <span class="pl-l-cluster" style="align-items: center; gap: var(--pl-space-1);">
            <kbd class="pl-c-kbd">⌥</kbd><kbd class="pl-c-kbd">L</kbd> Stream Tail
          </span>
          <span class="pl-l-cluster" style="align-items: center; gap: var(--pl-space-1);">
            <kbd class="pl-c-kbd">Esc</kbd> Reset Focus
          </span>
        </div>
        <div class="pl-u-muted" style="font-family: var(--pl-font-mono);">
          PORCHLIGHT INDUSTRIAL PRECISION V0.13.1
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
