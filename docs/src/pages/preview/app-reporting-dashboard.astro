---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PreviewToolbar from '../../components/PreviewToolbar.astro';

const kpis = [
  {
    label: 'Global liquid reserves',
    value: '$142.8M',
    unit: '',
    direction: 'up',
    trend: '+12.8% vs prior',
    spark: 'M0 30 L10 28 L20 25 L30 26 L40 18 L50 16 L60 10 L70 5',
    tone: 'success',
  },
  {
    label: '30-day liquidity burn',
    value: '$18.4M',
    unit: '',
    direction: 'down',
    trend: '-3.2% vs budget',
    spark: 'M0 12 L10 16 L20 18 L30 22 L40 24 L50 26 L60 28 L70 30',
    tone: undefined,
  },
  {
    label: 'FX hedge coverage',
    value: '94.2',
    unit: '%',
    direction: 'up',
    trend: '+4.1 pts',
    spark: 'M0 24 L10 23 L20 18 L30 20 L40 15 L50 12 L60 8 L70 6',
    tone: 'success',
  },
  {
    label: 'Pending settlement',
    value: '$8.6M',
    unit: '',
    direction: 'up',
    trend: '14 wire batches',
    spark: 'M0 8 L10 12 L20 14 L30 18 L40 22 L50 24 L60 29 L70 32',
    tone: 'warning',
  },
];

const bars = [62, 74, 68, 91, 86, 104, 118, 126, 132, 149, 142, 164];
const weeks = ['W1', 'W2', 'W3', 'W4', 'W5', 'W6', 'W7', 'W8', 'W9', 'W10', 'W11', 'W12'];
const settlements = [
  { id: 'TX-9481', beneficiary: 'JPMorgan Chase NY', entity: 'US Operations', currency: 'USD', amount: '$2,450,000.00', date: '2026-06-30', status: 'Pending Approval' },
  { id: 'TX-9482', beneficiary: 'BNP Paribas Paris', entity: 'EU Central Treasury', currency: 'EUR', amount: '€1,820,000.00', date: '2026-06-30', status: 'Pending Approval' },
  { id: 'TX-9483', beneficiary: 'SMBC Tokyo Global', entity: 'APAC Settlement', currency: 'JPY', amount: '¥145,000,000', date: '2026-07-01', status: 'CFO Dual-Auth' },
  { id: 'TX-9484', beneficiary: 'Barclays London UK', entity: 'UK Holdings Ltd', currency: 'GBP', amount: '£640,000.00', date: '2026-07-01', status: 'Pending Approval' },
];

const channels = [
  { name: 'Direct corporate treasury', segment: 'Enterprise', revenue: '$88.4M', growth: '+18.6%', conversion: '9.4%', status: 'Ahead' },
  { name: 'Cross-border FX flow', segment: 'Institutional', revenue: '$34.2M', growth: '+11.2%', conversion: '21.8%', status: 'On track' },
  { name: 'Merchant liquidity credit', segment: 'Mid-market', revenue: '$14.6M', growth: '+6.8%', conversion: '14.2%', status: 'Watch' },
  { name: 'Money market sweep', segment: 'Treasury Pool', revenue: '$5.6M', growth: '+24.1%', conversion: '31.6%', status: 'Ahead' },
];

const toneFor = (status: string) =>
  ({ Ahead: 'success', 'On track': 'accent', Watch: 'warning', 'Pending Approval': 'warning', 'CFO Dual-Auth': 'danger' }[status] ?? 'accent');
---
<BaseLayout title="Revenue performance & treasury operations · Porchlight" palette="emerald" density="compact">
  <PreviewToolbar palette="emerald" density="compact" title="Fintech Treasury & Capital Operations" />

  <div class="pl-l-stack reporting-shell" data-pl-palette="emerald" data-pl-density="compact">
    <section class="pl-l-stack reporting-header-stack" aria-labelledby="report-title">
      <div class="pl-c-page-header">
        <div class="pl-c-page-header__heading">
          <h1 class="pl-c-page-header__title" id="report-title">Revenue performance</h1>
          <span class="pl-c-page-header__subtitle">
            Global Multi-Currency Cash & Liquidity Desk · Value Date: <time datetime="2026-06-29T09:42:00">Jun 29, 2026 at 9:42 AM</time>
          </span>
        </div>
        <div class="pl-c-page-header__actions">
          <div class="pl-c-segmented" role="group" aria-label="Reporting timeline intervals">
            <button class="pl-c-segmented__item" aria-pressed="true" type="button">Q2 2026</button>
            <button class="pl-c-segmented__item" aria-pressed="false" type="button">June</button>
            <button class="pl-c-segmented__item" aria-pressed="false" type="button">W26</button>
          </div>
          <button class="pl-c-button" data-variant="secondary">Refresh</button>
          <button class="pl-c-button" data-variant="primary">
            <Icon name="download" />
            Export NACHA/ISO
          </button>
        </div>
      </div>

      <nav class="pl-c-saved-views" aria-label="Saved report views">
        <span class="pl-c-saved-views__label">Views</span>
        <ul class="pl-c-saved-views__list">
          <li class="pl-c-saved-views__item">
            <button class="pl-c-saved-views__button" aria-current="true">
              Treasury Executive <span class="pl-c-saved-views__count">12</span>
            </button>
          </li>
          <li class="pl-c-saved-views__item">
            <button class="pl-c-saved-views__button">
              Cross-border FX <span class="pl-c-saved-views__count">8</span>
            </button>
          </li>
          <li class="pl-c-saved-views__item">
            <button class="pl-c-saved-views__button">
              Pending Wire Settlement <span class="pl-c-saved-views__count">4</span>
            </button>
          </li>
          <li class="pl-c-saved-views__item">
            <button class="pl-c-saved-views__button">
              Liquidity At Risk <span class="pl-c-saved-views__count">2</span>
            </button>
          </li>
        </ul>
      </nav>

      <div class="pl-c-filter-builder" role="region" aria-label="Treasury query filter builder">
        <div class="pl-c-filter-builder__header">
          <h2 class="pl-c-filter-builder__title">Active treasury filters</h2>
          <div class="pl-c-filter-builder__actions">
            <button class="pl-c-button" data-variant="ghost" data-size="sm">Clear all</button>
            <button class="pl-c-button" data-variant="secondary" data-size="sm">Add rule</button>
          </div>
        </div>
        <div class="pl-c-filter-builder__chips">
          <span class="pl-c-query-chip">
            <span class="pl-c-query-chip__field">Entity</span>
            <span class="pl-c-query-chip__operator">in</span>
            <span class="pl-c-query-chip__value">US Ops, EU Treasury, APAC</span>
            <button class="pl-c-query-chip__remove" aria-label="Remove entity filter">x</button>
          </span>
          <span class="pl-c-query-chip">
            <span class="pl-c-query-chip__field">Settlement</span>
            <span class="pl-c-query-chip__operator">currency</span>
            <span class="pl-c-query-chip__value">USD, EUR, JPY, GBP</span>
            <button class="pl-c-query-chip__remove" aria-label="Remove currency filter">x</button>
          </span>
          <span class="pl-c-query-chip">
            <span class="pl-c-query-chip__field">Batch amount</span>
            <span class="pl-c-query-chip__operator">&gt;=</span>
            <span class="pl-c-query-chip__value">$50,000.00</span>
            <button class="pl-c-query-chip__remove" aria-label="Remove amount filter">x</button>
          </span>
        </div>
      </div>
    </section>

    <div class="pl-c-tabs">
      <div class="pl-c-tabs__list" role="tablist" aria-label="Report sections">
        <button class="pl-c-tabs__tab" role="tab" aria-selected="true" id="tab-summary" aria-controls="panel-summary" tabindex="0">
          Executive Treasury <span class="pl-c-tabs__count">4</span>
        </button>
        <button class="pl-c-tabs__tab" role="tab" aria-selected="false" id="tab-acquisition" aria-controls="panel-acquisition" tabindex="-1">
          Settlement Queues
        </button>
        <button class="pl-c-tabs__tab" role="tab" aria-selected="false" id="tab-retention" aria-controls="panel-retention" tabindex="-1">
          Risk & Compliance
        </button>
      </div>
      <div class="pl-c-tabs__panel pl-l-stack reporting-panel-stack" role="tabpanel" id="panel-summary" aria-labelledby="tab-summary">
        <section class="pl-l-grid reporting-kpi-grid" aria-label="Key performance indicators">
          {kpis.map((item) => (
            <article class="pl-c-card" data-surface="app">
              <div class="pl-c-card__body">
                <div class="pl-c-stat">
                  <span class="pl-c-stat__label">{item.label}</span>
                  <div class="pl-c-stat__value" data-tone={item.tone}>
                    {item.value}<span class="pl-c-stat__unit">{item.unit}</span>
                  </div>
                  <span class="pl-c-stat__trend" data-direction={item.direction}>{item.trend}</span>
                  <div class="pl-c-stat__spark">
                    <svg viewBox="0 0 70 36" width="100%" height="36" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                      <path
                        d={item.spark}
                        fill="none"
                        stroke={item.direction === 'down' ? 'var(--pl-color-danger)' : 'var(--pl-color-success)'}
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </section>

        <div class="pl-l-sidebar reporting-sidebar">
          <section class="pl-c-chart" aria-labelledby="revenue-trend-title" aria-describedby="revenue-trend-description">
            <header class="pl-c-chart__header">
              <div>
                <h2 class="pl-c-chart__title" id="revenue-trend-title">Revenue trend</h2>
                <p class="pl-c-chart__description" id="revenue-trend-description">
                  Weekly recurring liquidity flows with treasury forecast overlay.
                </p>
              </div>
              <div class="pl-c-chart__metrics" aria-label="Trend summary">
                <div class="pl-c-chart__metric">
                  <span class="pl-c-chart__metric-label">Forecast</span>
                  <strong class="pl-c-chart__metric-value">$154M</strong>
                  <span class="pl-c-chart__metric-delta" data-direction="up">+6.5%</span>
                </div>
              </div>
            </header>
            <div class="pl-c-chart__plot" role="img" aria-label="Bar and line chart showing weekly revenue increasing across the quarter">
              <svg viewBox="0 0 720 280" aria-hidden="true" focusable="false" preserveAspectRatio="none">
                <line x1="44" y1="236" x2="696" y2="236" stroke="var(--pl-color-border)" />
                <line x1="44" y1="40" x2="44" y2="236" stroke="var(--pl-color-border)" />
                {bars.map((value, index) => {
                  const x = 64 + index * 52;
                  const height = value * 0.92;
                  const y = 236 - height;
                  return (
                    <>
                      <rect x={x} y={y} width="28" height={height} rx="5" fill="var(--pl-color-accent)" opacity="0.9" />
                      <text x={x + 14} y="260" text-anchor="middle" fill="var(--pl-color-text-muted)" font-size="12">{weeks[index]}</text>
                    </>
                  );
                })}
                <path d="M78 188 L130 174 L182 166 L234 136 L286 145 L338 118 L390 106 L442 96 L494 90 L546 70 L598 76 L650 50" fill="none" stroke="var(--pl-color-success)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <ul class="pl-c-chart__legend" aria-label="Series">
              <li class="pl-c-chart__legend-item">
                <span class="pl-c-chart__swatch reporting-swatch-actual"></span>
                Actual liquidity flow
              </li>
              <li class="pl-c-chart__legend-item">
                <span class="pl-c-chart__swatch reporting-swatch-forecast"></span>
                Forecast reserve
              </li>
            </ul>
            <p class="pl-c-chart__caption">Includes closed-won expansion, cross-border sweeps, and self-serve inflows.</p>
          </section>

          <aside class="pl-l-stack reporting-insights" aria-label="Report insights">
            <section class="pl-c-card" data-surface="app">
              <header class="pl-c-card__header">
                <h2 class="pl-c-card__title">Capital adequacy dials</h2>
                <span class="pl-c-badge" data-tone="success">Tier 1</span>
              </header>
              <div class="pl-c-card__body">
                <div class="treasury-gauges-cluster">
                  <div class="treasury-gauge-wrapper">
                    <div class="pl-c-gauge" style="--pl-gauge-value: 84%;" role="meter" aria-valuenow="84" aria-valuemin="0" aria-valuemax="100" aria-label="Runway ratio">
                      <div class="pl-c-gauge__track"></div>
                      <div class="pl-c-gauge__center">
                        <span class="pl-c-gauge__value">18.4m</span>
                        <span class="pl-c-gauge__label">Runway</span>
                      </div>
                    </div>
                    <span class="treasury-gauge-subtext">Target: &gt; 12 mo</span>
                  </div>
                  <div class="treasury-gauge-wrapper">
                    <div class="pl-c-gauge" data-tone="accent" style="--pl-gauge-value: 74%;" role="meter" aria-valuenow="74" aria-valuemin="0" aria-valuemax="100" aria-label="Capital adequacy">
                      <div class="pl-c-gauge__track"></div>
                      <div class="pl-c-gauge__center">
                        <span class="pl-c-gauge__value">24.6%</span>
                        <span class="pl-c-gauge__label">CAR</span>
                      </div>
                    </div>
                    <span class="treasury-gauge-subtext">Statutory: 15%</span>
                  </div>
                </div>
              </div>
            </section>

            <section class="pl-c-card" data-surface="app">
              <header class="pl-c-card__header">
                <h2 class="pl-c-card__title">Insight queue</h2>
                <span class="pl-c-badge" data-tone="success">New</span>
              </header>
              <div class="pl-c-card__body pl-l-stack">
                <p>Cross-border liquidity flow is carrying 31% of the month-over-month reserve lift.</p>
                <p class="pl-u-muted-sm">Recommended action: review partner channel enablement before the next forecast lock.</p>
              </div>
              <footer class="pl-c-card__footer">
                <button class="pl-c-button" data-variant="secondary" data-size="sm">Add note</button>
              </footer>
            </section>
          </aside>
        </div>

        <section class="pl-c-card" data-surface="app" aria-labelledby="settlement-title">
          <div class="pl-c-toolbar">
            <div class="pl-c-toolbar__group">
              <h2 class="pl-c-card__title" id="settlement-title">Pending wire settlements</h2>
              <span class="pl-c-badge" data-tone="warning">4 batches ready</span>
            </div>
            <div class="pl-c-toolbar__group">
              <label class="pl-c-field">
                <span class="pl-u-sr-only">Search settlements</span>
                <input class="pl-c-field__control" type="search" placeholder="Search beneficiary or ID..." />
              </label>
              <button class="pl-c-button" data-variant="secondary" data-size="sm">
                <Icon name="download" />
                NACHA
              </button>
            </div>
          </div>
          <div class="pl-c-table-wrap" data-pl-density="compact" data-selection-region tabindex="0">
            <table class="pl-c-table reporting-table">
              <thead>
                <tr>
                  <th style="inline-size: 2.5rem;"><input type="checkbox" aria-label="Select all wire batches" /></th>
                  <th class="pl-c-table__sticky-col" data-sort="asc">Batch ID <span class="pl-c-table__sort-icon"></span></th>
                  <th>Beneficiary Bank</th>
                  <th>Entity</th>
                  <th>Currency</th>
                  <th data-align="end">Notional Amount</th>
                  <th>Value Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {settlements.map((tx, index) => (
                  <tr aria-selected={index === 0 ? 'true' : undefined}>
                    <td><input type="checkbox" aria-label={`Select ${tx.id}`} checked={index < 2} /></td>
                    <td class="pl-c-table__sticky-col"><code>{tx.id}</code></td>
                    <td>{tx.beneficiary}</td>
                    <td>{tx.entity}</td>
                    <td><span class="pl-c-badge" data-tone="neutral">{tx.currency}</span></td>
                    <td data-align="end"><strong>{tx.amount}</strong></td>
                    <td><time datetime={tx.date}>{tx.date}</time></td>
                    <td>
                      <span class="pl-c-badge" data-tone={toneFor(tx.status)}>{tx.status}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <aside class="pl-c-action-bar" role="toolbar" aria-label="Batch actions">
            <div class="pl-c-action-bar__lead">
              <span class="pl-c-action-bar__count">2 wire batches selected ($4,270,000)</span>
            </div>
            <div class="pl-c-action-bar__divider" aria-hidden="true"></div>
            <div class="pl-c-action-bar__actions">
              <button type="button" class="pl-c-button" data-variant="primary" data-size="sm">Approve wires (2)</button>
              <button type="button" class="pl-c-button" data-variant="secondary" data-size="sm">Request CFO Dual-Auth</button>
              <button type="button" class="pl-c-button" data-variant="ghost" data-size="sm">Export ISO 20022</button>
            </div>
          </aside>
        </section>

        <section class="pl-c-card" data-surface="app" aria-labelledby="breakdown-title">
          <div class="pl-c-toolbar">
            <div class="pl-c-toolbar__group">
              <h2 class="pl-c-card__title" id="breakdown-title">Channel breakdown</h2>
              <span class="pl-c-badge">4 liquidity channels</span>
            </div>
            <div class="pl-c-toolbar__group">
              <label class="pl-c-field">
                <span class="pl-u-sr-only">Search channels</span>
                <input class="pl-c-field__control" type="search" data-elastic="true" placeholder="Search channels..." />
              </label>
            </div>
          </div>
          <div class="pl-c-table-wrap" data-pl-density="compact" tabindex="0">
            <table class="pl-c-table reporting-table">
              <thead>
                <tr>
                  <th class="pl-c-table__sticky-col" data-sort="asc">Channel <span class="pl-c-table__sort-icon"></span></th>
                  <th>Segment</th>
                  <th data-align="end" data-sort="desc">Revenue <span class="pl-c-table__sort-icon"></span></th>
                  <th data-align="end">Growth</th>
                  <th data-align="end">Conversion</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {channels.map((channel, index) => (
                  <tr aria-selected={index === 0 ? 'true' : undefined}>
                    <td class="pl-c-table__sticky-col">{channel.name}</td>
                    <td>{channel.segment}</td>
                    <td data-align="end">{channel.revenue}</td>
                    <td data-align="end">{channel.growth}</td>
                    <td data-align="end">{channel.conversion}</td>
                    <td>
                      <span class="pl-c-badge" data-tone={toneFor(channel.status)}>{channel.status}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="pl-c-toolbar reporting-footer-toolbar">
            <div class="pl-c-toolbar__group">
              <span class="pl-u-muted-sm" aria-live="polite">Showing 4 active liquidity channels under Executive Treasury.</span>
            </div>
            <div class="pl-c-toolbar__group">
              <button class="pl-c-button" data-variant="ghost" data-size="sm">Open source ledger</button>
            </div>
          </div>
        </section>
      </div>
      <div class="pl-c-tabs__panel" role="tabpanel" id="panel-acquisition" aria-labelledby="tab-acquisition" hidden>
        <div class="pl-c-empty">
          <h2 class="pl-c-empty__title">Settlement queue view</h2>
          <p class="pl-c-empty__description">Direct clearing workflows across Federal Reserve Fedwire and TARGET2 euro systems.</p>
        </div>
      </div>
      <div class="pl-c-tabs__panel" role="tabpanel" id="panel-retention" aria-labelledby="tab-retention" hidden>
        <div class="pl-c-empty">
          <h2 class="pl-c-empty__title">Risk & compliance view</h2>
          <p class="pl-c-empty__description">OFAC screening, AML transaction monitoring, and capital reserve stress simulations.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .pl-c-card > .pl-c-toolbar {
    padding-inline: 0;
  }

  .reporting-footer-toolbar {
    border-block-start: 1px solid var(--pl-color-border);
    border-block-end: 0;
  }

  .reporting-shell {
    --pl-l-stack-gap: var(--pl-space-5);
  }

  .reporting-header-stack,
  .reporting-insights {
    --pl-l-stack-gap: var(--pl-space-4);
  }

  .reporting-panel-stack {
    --pl-l-stack-gap: var(--pl-space-5);
  }

  .reporting-kpi-grid {
    --pl-l-grid-min: 14rem;
  }

  .reporting-sidebar {
    --pl-l-sidebar-size: 20rem;
  }

  .reporting-swatch-actual {
    --pl-c-chart-series-color: var(--pl-color-accent);
  }

  .reporting-swatch-forecast {
    --pl-c-chart-series-color: var(--pl-color-success);
  }

  .reporting-table {
    --pl-c-table-min: 48rem;
  }

  .treasury-gauges-cluster {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: var(--pl-space-4);
    padding-block: var(--pl-space-2);
  }

  .treasury-gauge-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--pl-space-2);
  }

  .treasury-gauge-subtext {
    font-size: var(--pl-text-xs);
    color: var(--pl-color-text-muted);
    font-weight: var(--pl-font-weight-medium);
  }
</style>
