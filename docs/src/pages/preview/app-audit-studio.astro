---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PreviewToolbar from '../../components/PreviewToolbar.astro';

const kpis = [
  { label: 'CET1 ratio', value: '14.2', unit: '%', tone: 'success', trend: '+0.4' },
  { label: 'Liquidity coverage', value: '132', unit: '%', tone: 'accent', trend: '+6' },
  { label: 'FRTB capital', value: '$1.84', unit: 'B', tone: 'warning', trend: '+2.1%' },
  { label: 'Open findings', value: '7', unit: '', tone: 'danger', trend: '-3' },
];

const ledger = [
  { actor: 'MODEL RISK', action: 'APPROVED', target: 'SA-CCR v4.2', time: '09:42:18', tone: 'success' },
  { actor: 'POLICY', action: 'BLOCKED', target: 'limit override', time: '09:38:04', tone: 'danger' },
  { actor: 'AUDIT', action: 'SIGNED', target: 'evidence-8841', time: '09:31:22', tone: 'accent' },
  { actor: 'TREASURY', action: 'SUBMITTED', target: 'FRTB pack', time: '09:22:10', tone: 'neutral' },
  { actor: 'MODEL RISK', action: 'RECALIBRATED', target: 'IRRBB shocks', time: '09:14:55', tone: 'warning' },
];
---
<BaseLayout title="Financial Risk & Regulatory Audit Studio · Porchlight" palette="slate" density="compact">
  <PreviewToolbar palette="slate" theme="light" density="compact" title="Financial Risk & Regulatory Audit Studio" />
  <div
    class="pl-l-container pl-l-stack"
    style="--pl-l-container-max: 88rem; --pl-l-stack-gap: var(--pl-space-5); padding-block: var(--pl-space-6);"
  >
    <div class="pl-c-page-header">
      <div class="pl-c-page-header__heading">
        <h1 class="pl-c-page-header__title">Apex Risk Studio</h1>
        <span class="pl-c-page-header__subtitle">Capital adequacy, immutable evidence, and policy review</span>
      </div>
      <div class="pl-c-page-header__actions">
        <label class="pl-c-field pl-c-field--inline pl-c-field--search">
          <span class="pl-u-sr-only">Search the risk studio</span>
          <input class="pl-c-field__control studio-query-input" type="search" placeholder="Search models, policies, or evidence" />
        </label>
        <button class="pl-c-button" data-variant="secondary" data-size="sm">Export evidence</button>
        <button class="pl-c-button" data-variant="primary" data-size="sm">New assessment</button>
      </div>
    </div>

    <div class="pl-c-banner" data-tone="warning">
      <div class="pl-c-banner__content">
        <div class="pl-c-banner__main">
          <div class="pl-c-banner__message">
            <strong>Two policy findings are waiting for owner sign-off.</strong>
            <span class="pl-u-muted-sm">The retention clause and the limit override require dual approval.</span>
          </div>
        </div>
        <div class="pl-c-banner__actions">
          <kbd class="pl-c-kbd">⌘</kbd><kbd class="pl-c-kbd">⇧</kbd><kbd class="pl-c-kbd">A</kbd>
        </div>
      </div>
    </div>

    <div class="pl-l-grid" style="--pl-l-grid-min: 14rem; --pl-l-grid-gap: var(--pl-space-3);">
      {kpis.map((kpi) => (
        <article class="pl-c-kpi-card" data-tone={kpi.tone}>
          <header class="pl-c-kpi-card__header">
            <span class="pl-c-kpi-card__label">{kpi.label}</span>
            <span class="pl-c-badge" data-tone={kpi.tone}>{kpi.trend}</span>
          </header>
          <div class="pl-c-kpi-card__metric">
            <span class="pl-c-kpi-card__value pl-u-tabular-nums">{kpi.value}</span>
            {kpi.unit && <span class="pl-c-kpi-card__suffix">{kpi.unit}</span>}
          </div>
          <footer class="pl-c-kpi-card__footer">
            <span class="pl-u-muted-sm">vs prior quarter</span>
          </footer>
        </article>
      ))}
    </div>

    <div class="pl-c-split-pane studio-split" data-orientation="horizontal" data-collapse="stack">
      <section class="pl-c-split-pane__pane pl-c-split-pane__pane--start">
        <div class="pl-c-split-pane__header">
          <h2 class="pl-c-split-pane__title">Regulatory ledger</h2>
        </div>
        <div class="pl-c-split-pane__pane-inner">
          <ol class="pl-c-audit-stream" role="list" aria-label="Regulatory audit stream">
            {ledger.map((event) => (
              <li class="pl-c-audit-stream__item">
                <div class="pl-c-avatar pl-c-audit-stream__avatar" data-size="sm">{event.actor.slice(0, 2)}</div>
                <div class="pl-c-audit-stream__body">
                  <div class="pl-c-audit-stream__header">
                    <span class="pl-c-audit-stream__actor">{event.actor}</span>
                    <span class="pl-c-badge" data-tone={event.tone} data-size="sm">{event.action}</span>
                    <time class="pl-c-audit-stream__time pl-u-tabular-nums">{event.time}</time>
                  </div>
                  <div class="pl-c-audit-stream__target"><code class="pl-c-audit-stream__mono">{event.target}</code></div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <div class="pl-c-split-pane__separator" aria-hidden="true"></div>

      <section class="pl-c-split-pane__pane pl-c-split-pane__pane--end">
        <div class="pl-c-split-pane__header">
          <h2 class="pl-c-split-pane__title">Counterparty inspector</h2>
        </div>
        <div class="pl-c-split-pane__pane-inner pl-l-stack" style="--pl-l-stack-gap: var(--pl-space-3);">
          <dl class="pl-c-property-list" data-subgrid="true">
            <div class="pl-c-property-list__item">
              <dt class="pl-c-property-list__key">Legal entity</dt>
              <dd class="pl-c-property-list__value">Apex Clearing Europe SA</dd>
            </div>
            <div class="pl-c-property-list__item">
              <dt class="pl-c-property-list__key">Exposure</dt>
              <dd class="pl-c-property-list__value pl-u-tabular-nums">$184.2M</dd>
            </div>
            <div class="pl-c-property-list__item">
              <dt class="pl-c-property-list__key">Risk rating</dt>
              <dd class="pl-c-property-list__value"><span class="pl-c-badge" data-tone="warning">Watch</span></dd>
            </div>
          </dl>

          <div class="pl-c-code-block" data-language="yaml" data-line-numbers="true">
            <div class="pl-c-code-block__header">
              <div class="pl-c-code-block__meta">
                <span class="pl-c-code-block__title">retention-policy.diff</span>
              </div>
            </div>
            <pre class="pl-c-code-block__pre"><code class="pl-c-code-block__code"><span class="pl-c-code-block__line" data-line="1">retention:</span>
<span class="pl-c-code-block__line" data-line="2" data-diff="remove">- days: 30</span>
<span class="pl-c-code-block__line" data-line="3" data-diff="add">+ days: 90</span>
<span class="pl-c-code-block__line" data-line="4" data-diff="add">+ legal_hold: true</span></code></pre>
          </div>
          <div class="pl-l-cluster" style="--pl-l-cluster-gap: var(--pl-space-2);">
            <kbd class="pl-c-kbd">⌘</kbd><kbd class="pl-c-kbd">⇧</kbd><kbd class="pl-c-kbd">A</kbd>
            <span class="pl-u-muted-sm">Approve finding</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
