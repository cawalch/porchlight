---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Action Bar · Porchlight">
  <h1>Action Bar</h1>
  <p>
    Floating batch action bar for tables, card grids, and mass-selection workflows.
    Features pure-CSS reactive auto-reveal via <code>:has(:checked)</code>, liquid glass styling,
    and responsive pill geometry.
  </p>

  <h2>Interactive Pure-CSS Reveal</h2>
  <p class="pl-u-text-muted">
    Check any box in the table below to trigger the floating batch action bar without JavaScript.
  </p>

  <div class="pl-c-table-wrap" tabindex="0">
    <table class="pl-c-table">
      <thead>
        <tr>
          <th class="pl-c-table__check"><input type="checkbox" id="check-all" aria-label="Select all rows" /></th>
          <th>Cluster Instance</th>
          <th>Region</th>
          <th>Health</th>
          <th>Nodes</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="pl-c-table__check"><input type="checkbox" id="check-row-1" aria-label="Select prod-db-01" /></td>
          <td><code>prod-db-01</code></td>
          <td>us-east-1</td>
          <td><span class="pl-c-badge" data-tone="success">Optimal</span></td>
          <td>12</td>
        </tr>
        <tr>
          <td class="pl-c-table__check"><input type="checkbox" id="check-row-2" aria-label="Select prod-cache-04" /></td>
          <td><code>prod-cache-04</code></td>
          <td>eu-central-1</td>
          <td><span class="pl-c-badge" data-tone="success">Optimal</span></td>
          <td>8</td>
        </tr>
        <tr>
          <td class="pl-c-table__check"><input type="checkbox" id="check-row-3" aria-label="Select dev-worker-09" /></td>
          <td><code>dev-worker-09</code></td>
          <td>us-west-2</td>
          <td><span class="pl-c-badge" data-tone="warning">Degraded</span></td>
          <td>4</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Reactive Sibling Floating Action Bar -->
  <div class="pl-c-action-bar" role="toolbar" aria-label="Table batch actions" id="demo-action-bar">
    <div class="pl-c-action-bar__lead">
      <span class="pl-c-action-bar__count">Active Selection</span>
    </div>
    <div class="pl-c-action-bar__divider" aria-hidden="true"></div>
    <div class="pl-c-action-bar__actions">
      <button type="button" class="pl-c-button" data-variant="ghost" data-size="sm">Export CSV</button>
      <button type="button" class="pl-c-button" data-variant="ghost" data-size="sm">Add Tag</button>
      <button type="button" class="pl-c-button" data-tone="danger" data-variant="ghost" data-size="sm">Terminate</button>
    </div>
    <button type="button" class="pl-c-action-bar__dismiss" aria-label="Clear selection">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
      </svg>
    </button>
  </div>

  <h2 style="margin-block-start: var(--pl-space-8);">Inline Static Variant</h2>
  <p class="pl-u-text-muted">Explicitly rendered with <code>data-open="true"</code> and <code>data-position="inline"</code>.</p>

  <div class="pl-c-card" style="padding: var(--pl-space-4); overflow-x: auto;">
    <div class="pl-c-action-bar" data-open="true" data-position="inline" role="toolbar" aria-label="Inline batch actions">
      <div class="pl-c-action-bar__lead">
        <span class="pl-c-action-bar__count">4 items selected</span>
      </div>
      <div class="pl-c-action-bar__divider" aria-hidden="true"></div>
      <div class="pl-c-action-bar__actions">
        <button type="button" class="pl-c-button" data-variant="ghost" data-size="sm">Export</button>
        <button type="button" class="pl-c-button" data-tone="danger" data-variant="ghost" data-size="sm">Delete</button>
      </div>
      <button type="button" class="pl-c-action-bar__dismiss" aria-label="Cancel">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
        </svg>
      </button>
    </div>
  </div>
</BaseLayout>
