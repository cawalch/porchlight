---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Form · Porchlight">
  <h1>Form</h1>
  <p>
    SaaS form composition patterns: settings sections, responsive grids,
    filter rows, billing inputs, choice groups, dense admin metadata, and
    action rows.
  </p>

  <h2>Account settings</h2>
  <form class="pl-c-form demo-form" data-preview-form-grid>
    <section class="pl-c-form__section">
      <div class="pl-c-form__header">
        <h3>Workspace</h3>
        <p>Identity, URL, and regional defaults for this account.</p>
      </div>
      <div class="pl-c-form__body">
        <div class="pl-c-form__grid">
          <label class="pl-c-field">
            <span class="pl-c-field__label">Workspace name</span>
            <input class="pl-c-field__control" value="Acme Ops" />
            <span class="pl-c-field__hint">Visible to everyone in the workspace.</span>
          </label>

          <div class="pl-c-field">
            <label class="pl-c-field__label" for="settings-slug">Workspace URL</label>
            <div class="pl-c-input-group">
              <input id="settings-slug" class="pl-c-field__control" value="acme-ops" />
              <span class="pl-c-input-group__addon">.porchlight.app</span>
            </div>
            <span class="pl-c-field__hint">Used in invite links and bookmarks.</span>
          </div>

          <label class="pl-c-field">
            <span class="pl-c-field__label">Default timezone</span>
            <select class="pl-c-field__control">
              <option>America/Chicago</option>
              <option>America/New_York</option>
              <option>Europe/London</option>
            </select>
          </label>

          <label class="pl-c-field">
            <span class="pl-c-field__label">Support email</span>
            <input class="pl-c-field__control" type="email" value="support@acme.example" />
          </label>
        </div>
      </div>
    </section>

    <section class="pl-c-form__section">
      <div class="pl-c-form__header">
        <h3>Notifications</h3>
        <p>Native checkboxes with descriptions and disabled states.</p>
      </div>
      <div class="pl-c-form__body">
        <fieldset class="pl-c-choice-group" data-preview-choice-group aria-describedby="email-updates-help">
          <legend class="pl-c-choice-group__legend">Email updates</legend>
          <div class="pl-c-choice-list">
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="checkbox" checked />
              <span>
                <span class="pl-c-choice__label">Weekly summary</span>
                <span class="pl-c-choice__description">Usage, billing, and team activity every Monday.</span>
              </span>
            </label>
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="checkbox" checked />
              <span>
                <span class="pl-c-choice__label">Security alerts</span>
                <span class="pl-c-choice__description">Immediate notifications for risky account events.</span>
              </span>
            </label>
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="checkbox" disabled />
              <span>
                <span class="pl-c-choice__label">Enterprise digest</span>
                <span class="pl-c-choice__description">Available on Enterprise plans.</span>
              </span>
            </label>
          </div>
          <span class="pl-c-choice-group__hint" id="email-updates-help" data-tone="warning">
            Security alerts stay enabled for account owners.
          </span>
        </fieldset>
      </div>
    </section>

    <div class="pl-c-form__actions">
      <button class="pl-c-button" type="button" data-variant="ghost">Cancel</button>
      <button class="pl-c-button" type="submit" data-variant="primary">Save changes</button>
    </div>
  </form>

  <h2>Billing setup</h2>
  <form class="pl-c-form demo-form">
    <section class="pl-c-form__section">
      <div class="pl-c-form__body">
        <div class="pl-c-form__grid">
          <div class="pl-c-field">
            <label class="pl-c-field__label" for="monthly-budget">Monthly budget</label>
            <div class="pl-c-input-group">
              <span class="pl-c-input-group__addon">$</span>
              <input id="monthly-budget" class="pl-c-field__control" type="number" value="2400" />
              <span class="pl-c-input-group__addon">USD</span>
            </div>
          </div>

          <div class="pl-c-field">
            <label class="pl-c-field__label" for="seats">Seats</label>
            <div class="pl-c-input-group">
              <input id="seats" class="pl-c-field__control" type="number" value="48" />
              <span class="pl-c-input-group__addon">users</span>
            </div>
          </div>
        </div>

        <fieldset class="pl-c-choice-group" aria-describedby="billing-cadence-help">
          <legend class="pl-c-choice-group__legend">Billing cadence</legend>
          <div class="pl-c-choice-list" data-layout="inline">
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="radio" name="cadence" />
              <span class="pl-c-choice__label">Monthly</span>
            </label>
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="radio" name="cadence" checked />
              <span class="pl-c-choice__label">Annual</span>
            </label>
          </div>
          <span class="pl-c-choice-group__hint" id="billing-cadence-help" data-tone="success">
            Annual billing is active for this workspace.
          </span>
        </fieldset>
      </div>
    </section>
  </form>

  <h2>Choice validation</h2>
  <form class="pl-c-form demo-form">
    <section class="pl-c-form__section">
      <div class="pl-c-form__body">
        <fieldset
          class="pl-c-choice-group"
          data-preview-choice-invalid
          aria-invalid="true"
          aria-describedby="review-routing-error"
        >
          <legend class="pl-c-choice-group__legend">Review routing</legend>
          <div class="pl-c-choice-list">
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="radio" name="routing" />
              <span class="pl-c-choice__label">Any available reviewer</span>
            </label>
            <label class="pl-c-choice">
              <input class="pl-c-choice__input" type="radio" name="routing" />
              <span class="pl-c-choice__label">Assigned team only</span>
            </label>
          </div>
          <span class="pl-c-choice-group__hint" id="review-routing-error" data-tone="danger" role="alert">
            Select a routing policy before saving.
          </span>
        </fieldset>
      </div>
    </section>
  </form>

  <h2>Filter row</h2>
  <form class="pl-c-form demo-form" data-pl-density="compact">
    <div class="pl-c-form__row">
      <label class="pl-c-field">
        <span class="pl-u-sr-only">Search cases</span>
        <input class="pl-c-field__control" type="search" placeholder="Search cases..." />
      </label>
      <label class="pl-c-field">
        <span class="pl-c-field__label">Status</span>
        <select class="pl-c-field__control">
          <option>Open</option>
          <option>Escalated</option>
          <option>Closed</option>
        </select>
      </label>
      <label class="pl-c-field">
        <span class="pl-c-field__label">Owner</span>
        <select class="pl-c-field__control">
          <option>Any owner</option>
          <option>Mine</option>
        </select>
      </label>
      <button class="pl-c-button" type="button" data-variant="primary">Apply</button>
    </div>
  </form>

  <h2>Dense admin metadata</h2>
  <form class="pl-c-form demo-form dense-form" data-pl-density="compact">
    <section class="pl-c-form__section">
      <div class="pl-c-form__body">
        <label class="pl-c-field pl-c-field--inline">
          <span class="pl-c-field__label">Customer ID</span>
          <input class="pl-c-field__control" value="cus_9N3K42" readonly />
          <span class="pl-c-field__hint">Read-only identifiers stay selectable.</span>
        </label>
        <label class="pl-c-field pl-c-field--inline">
          <span class="pl-c-field__label">Data region</span>
          <select class="pl-c-field__control">
            <option>US Central</option>
            <option>EU West</option>
          </select>
        </label>
        <label class="pl-c-field pl-c-field--inline">
          <span class="pl-c-field__label">Risk threshold</span>
          <input class="pl-c-field__control" type="number" value="72" />
          <span class="pl-c-field__hint">Higher values reduce review volume.</span>
        </label>
      </div>
    </section>
  </form>

  <h2>Two-column aligned form (CSS Subgrid)</h2>
  <p>Add <code>data-layout="aligned"</code> to an <code>.pl-c-form</code> to align label and input columns across fields using CSS Subgrid. Labels size dynamically to the widest label in the form without hardcoded widths or JavaScript, and collapse to a single column on narrow screens.</p>
  <form class="pl-c-form demo-form aligned-form" data-layout="aligned">
    <div class="pl-c-field">
      <label class="pl-c-field__label" for="subgrid-name">Full legal name</label>
      <input id="subgrid-name" class="pl-c-field__control" value="Alex Morgan" />
    </div>

    <div class="pl-c-field">
      <label class="pl-c-field__label" for="subgrid-org">Organization or department</label>
      <input id="subgrid-org" class="pl-c-field__control" value="Platform Infrastructure" />
    </div>

    <div class="pl-c-field">
      <label class="pl-c-field__label" for="subgrid-email">Direct contact email address</label>
      <input id="subgrid-email" class="pl-c-field__control" type="email" value="alex@platform.example" />
      <span class="pl-c-field__hint">Used for urgent security notifications.</span>
    </div>

    <div class="pl-c-form__actions">
      <button type="button" class="pl-c-button" data-variant="ghost">Cancel</button>
      <button type="submit" class="pl-c-button" data-variant="primary">Save changes</button>
    </div>
  </form>

  <h2>Pure-CSS conditional field disclosure</h2>
  <p>
    Dependent fields smoothly expand and collapse via <code>.pl-c-form__conditional</code> driven by
    <code>interpolate-size: allow-keywords</code> and parent <code>:checked</code> state without JavaScript.
  </p>
  <form class="pl-c-form demo-form" data-preview-conditional-form>
    <section class="pl-c-form__section">
      <div class="pl-c-form__header">
        <h3>Outbound integrations</h3>
        <p>Configure automated webhooks for deployment events.</p>
      </div>
      <div class="pl-c-form__body">
        <div class="pl-c-form__conditional-group" data-preview-conditional-switch>
          <label class="pl-c-switch">
            <input type="checkbox" id="enable-webhook" role="switch" class="pl-c-switch__input" />
            <span class="pl-c-switch__track">
              <span class="pl-c-switch__thumb"></span>
            </span>
            <span class="pl-c-switch__label">Enable Webhook Dispatch</span>
          </label>
          <div class="pl-c-form__conditional" id="webhook-conditional">
            <div class="pl-c-form__conditional-inner">
              <div class="pl-c-form__grid">
                <div class="pl-c-field">
                  <label class="pl-c-field__label" for="webhook-url">Endpoint URL</label>
                  <input
                    id="webhook-url"
                    class="pl-c-field__control"
                    type="url"
                    placeholder="https://api.acme.example/events"
                  />
                  <span class="pl-c-field__hint">Payloads are signed with HMAC-SHA256.</span>
                </div>
                <div class="pl-c-field">
                  <label class="pl-c-field__label" for="webhook-secret">Signing secret</label>
                  <input
                    id="webhook-secret"
                    class="pl-c-field__control"
                    type="password"
                    placeholder="whsec_••••••••••••"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </form>

  <h2>Reactive form validation summary</h2>
  <p>
    Live warning alert banner (<code>.pl-c-form__summary</code>) driven entirely by <code>form:has(:user-invalid)</code>.
    When any field becomes invalid, the summary illuminates and the submit button reflects warning feedback.
  </p>
  <form class="pl-c-form demo-form" data-preview-reactive-form>
    <div class="pl-c-form__summary" role="alert" data-preview-summary>
      <svg class="pl-c-form__summary-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span>Please correct the errors in the highlighted fields before submitting.</span>
    </div>

    <section class="pl-c-form__section">
      <div class="pl-c-form__body">
        <div class="pl-c-field">
          <label class="pl-c-field__label" for="org-handle">
            Organization handle
            <span class="pl-c-field__required">*</span>
          </label>
          <input
            id="org-handle"
            class="pl-c-field__control"
            required
            pattern="[a-z0-9-]{3,20}"
            value="Org with spaces"
            aria-invalid="true"
            aria-describedby="org-handle-hint"
          />
          <span class="pl-c-field__hint" id="org-handle-hint">
            Lowercase alphanumeric characters and hyphens only (3–20 chars).
          </span>
        </div>
      </div>
    </section>

    <div class="pl-c-form__actions">
      <button type="button" class="pl-c-button" data-variant="ghost">Cancel</button>
      <button type="submit" class="pl-c-button" data-variant="primary" data-reactive="invalid">
        Create Organization
      </button>
    </div>
  </form>
</BaseLayout>

<style>
  .demo-form {
    padding: var(--pl-space-5);
    margin-block-end: var(--pl-space-5);
    background: var(--pl-color-surface);
    border: 1px solid var(--pl-color-border);
    border-radius: var(--pl-radius-lg);
  }

  .dense-form,
  .aligned-form {
    max-inline-size: 46rem;
  }
</style>
