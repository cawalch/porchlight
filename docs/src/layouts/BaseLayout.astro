---
/**
 * BaseLayout — the HTML shell for every docs page.
 *
 * Styling lives in src/styles/global.css. The docs chrome now consumes the
 * Porchlight --pl-* token layer directly; only docs-specific layout geometry
 * remains under --doc-* custom properties.
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  search?: boolean;
  skipTarget?: string;
}

const {
  title = 'Porchlight',
  description = 'A no-dependency, native-CSS framework.',
  search = false,
  skipTarget = 'main',
} = Astro.props;

// Resolve internal links against the build-time base path so the site works
// both at the Pages root (/porchlight/) and under PR previews (/porchlight/pr-preview/pr-<n>/).
const b = import.meta.env.BASE_URL;
const link = (path: string) => `${b}${path.replace(/^\//, '')}`;

const nav = [
  { href: link('guides'), label: 'Guides', external: false },
  { href: link('components'), label: 'Components', external: false },
  { href: link('tokens'), label: 'Tokens', external: false },
  { href: link('preview'), label: 'Examples', external: false },
  { href: 'https://github.com/cawalch/porchlight', label: 'GitHub', external: true },
];

const here = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  if (href.startsWith('http')) return false;
  const clean = href.replace(/\/$/, '');
  // Exact match, or prefix match for nav sections.
  if (here === clean) return true;
  return here.startsWith(`${clean}/`);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${b}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script is:inline data-astro-rerun>
      document.documentElement.toggleAttribute('data-docs-embed', new URL(location.href).searchParams.get('embed') === '1');
    </script>
  </head>
  <body class:list={{ 'docs-page': search, 'preview-page': !search }}>
    <a class="skip-link" href={`#${skipTarget}`}>Skip to content</a>
    <header class="site-header">
      <a class="site-header__brand" href={b} aria-label="Porchlight docs home">
        <span class="site-header__mark" aria-hidden="true">P</span>
        <span class="site-header__brand-copy">
          <strong>Porchlight</strong>
          <small>Documentation</small>
        </span>
      </a>
      <div class="site-header__tools">
        {search && <button type="button" class="site-search" aria-label="Search docs" aria-haspopup="dialog" aria-controls="docs-search-dialog" data-docs-command-open>Search <kbd>⌘ K</kbd></button>}
      <nav class="site-nav" aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.external ? undefined : (isActive(item.href) ? 'page' : undefined)}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
        <details class="site-menu">
          <summary>Menu</summary>
          <nav aria-label="Primary"><ul>
            {nav.map(item => <li><a href={item.href} aria-current={item.external ? undefined : (isActive(item.href) ? 'page' : undefined)}>{item.label}</a></li>)}
          </ul></nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Porchlight · <a href="https://github.com/cawalch/porchlight">GitHub</a> · MIT</p>
    </footer>
  </body>
</html>

<script>
  let headerObserver: ResizeObserver | undefined;
  function measureHeader() {
    headerObserver?.disconnect();
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const update = () => document.documentElement.style.setProperty('--doc-header-size', `${header.getBoundingClientRect().height}px`);
    update();
    headerObserver = new ResizeObserver(update);
    headerObserver.observe(header);
  }
  measureHeader();
  document.addEventListener('astro:page-load', measureHeader);
  document.addEventListener('astro:before-swap', () => headerObserver?.disconnect());
</script>
