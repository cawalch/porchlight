---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsNavigation from '../components/DocsNavigation.astro';
import DocsContents from '../components/DocsContents.astro';
import '../styles/prose.css';
import '../styles/docs.css';

interface Props {
  title?: string;
  description?: string;
  sectionLabel?: string;
  status?: string;
  since?: string;
  previewHref?: string;
  sourceHref?: string;
  styleHref?: string;
  headings?: MarkdownHeading[];
  inlineExample?: boolean;
}
const {
  title, description, sectionLabel = 'Guides', status, since, previewHref,
  sourceHref, styleHref, headings = [], inlineExample = false,
} = Astro.props;
const b = import.meta.env.BASE_URL;
const pageName = title?.replace(/\s+·\s+Porchlight$/, '') ?? sectionLabel;
const entries = (await getCollection('components')).sort((a, z) => a.data.title.localeCompare(z.data.title));
const guides = (await getCollection('guides')).sort((a, z) => a.data.order - z.data.order);
const tokens = await getCollection('tokens');
const foundationIds = new Set(['architecture', 'layout', 'composition-recipes', 'utilities', 'enhancements']);
const sections = [
  { title: 'Guides', links: guides.filter(g => !foundationIds.has(g.id)).map(g => ({ href: `${b}guides/${g.id}`, label: g.data.title })) },
  { title: 'Foundations', links: guides.filter(g => foundationIds.has(g.id)).map(g => ({ href: `${b}guides/${g.id}`, label: g.data.title })) },
  { title: 'Tokens', links: tokens.map(t => ({ href: `${b}tokens/${t.id}`, label: t.data.title })) },
  { title: 'Components', links: entries.filter(e => e.data.kind === 'component').map(e => ({ href: `${b}components/${e.id}`, label: e.data.title })) },
  { title: 'Patterns', links: entries.filter(e => e.data.kind === 'pattern').map(e => ({ href: `${b}components/${e.id}`, label: e.data.title })) },
];
const contents = headings.filter(h => h.depth === 2 || h.depth === 3);
const actions = [
  previewHref && { href: previewHref, label: 'Open full example' },
  sourceHref && { href: sourceHref.replace('/blob/', '/edit/'), label: sourceHref.includes('/blob/') ? 'Edit this page' : 'Content source' },
  styleHref && { href: styleHref, label: 'CSS source' },
].filter(Boolean) as { href: string; label: string }[];
---
<BaseLayout title={title} description={description} search skipTarget="docs-article">
  <div class="docs-layout">
    <aside class="docs-sidebar"><DocsNavigation sections={sections} /></aside>
    <div class="docs-content" data-docs-content>
      <details class="docs-mobile-navigation">
        <summary>Browse docs</summary>
        <DocsNavigation sections={sections} />
      </details>
      <article id="docs-article" class="docs-article" tabindex="-1">
        <header class="docs-title">
          <p class="docs-section-label">{sectionLabel}</p>
          <h1>{pageName}</h1>
          {description && <p class="docs-description">{description}</p>}
          {(status || since) && (
            <p class="docs-meta">
              {status && <span class="pl-c-badge" data-tone={status === 'experimental' ? 'warning' : undefined}>{status}</span>}
              {since && <span>Since {since}</span>}
            </p>
          )}
          {previewHref && !inlineExample && <a href={previewHref} class="docs-example-link">Open full example →</a>}
        </header>
        {contents.length > 0 && (
          <details class="docs-mobile-contents">
            <summary>On this page</summary>
            <DocsContents headings={contents} />
          </details>
        )}
        {inlineExample && previewHref && (
          <figure class="docs-example">
            <figcaption>Example <a href={previewHref}>Open in a new page</a></figcaption>
            <iframe src={`${previewHref}?embed=1`} title={`${pageName} example`} loading="lazy"></iframe>
          </figure>
        )}
        <slot />
        {actions.length > 0 && (
          <footer class="docs-page-links" aria-label="Page links">
            {actions.map(action => <a href={action.href}>{action.label}</a>)}
          </footer>
        )}
      </article>
    </div>
    {contents.length > 0 && (
      <aside class="docs-contents">
        <nav aria-label="On this page"><h2>On this page</h2><DocsContents headings={contents} /></nav>
      </aside>
    )}
  </div>
  <dialog class="docs-search-dialog" id="docs-search-dialog" aria-labelledby="docs-search-title" data-docs-command-dialog data-search-url={`${b}search.json`}>
    <header><h2 id="docs-search-title">Search Porchlight</h2><button class="pl-c-button" type="button" data-docs-command-close>Close</button></header>
    <label for="docs-command-filter">Search docs</label>
    <input id="docs-command-filter" class="pl-c-field__control" type="search" placeholder="Search pages, CSS classes, and tokens" autocomplete="off" data-docs-command-filter />
    <p class="docs-search-status" role="status" data-docs-search-status></p>
    <nav aria-label="Search results"><ul class="docs-search-results" data-docs-search-results></ul></nav>
  </dialog>
</BaseLayout>
<script>
  import '../scripts/docs';
</script>
