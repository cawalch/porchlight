---
const b = import.meta.env.BASE_URL;
---

<dialog
  class="docs-search-dialog"
  id="docs-search-dialog"
  aria-labelledby="docs-search-title"
  closedby="any"
  data-docs-command-dialog
  data-search-url={`${b}search.json`}
>
  <header>
    <h2 id="docs-search-title">Search Porchlight</h2>
    <button class="pl-c-button" type="button" data-docs-command-close
      >Close</button
    >
  </header>
  <label for="docs-command-filter">Search docs</label>
  <input
    id="docs-command-filter"
    class="pl-c-field__control"
    type="search"
    placeholder="Search pages, CSS classes, and tokens"
    autocomplete="off"
    data-docs-command-filter
  />
  <p class="docs-search-status" role="status" data-docs-search-status></p>
  <nav aria-label="Search results">
    <ul class="docs-search-results" data-docs-search-results></ul>
  </nav>
</dialog>

<script>
  import "../scripts/docs";
</script>
